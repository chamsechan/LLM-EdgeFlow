@startuml LLM_EdgeFlow_Target_Architecture_V2
!pragma layout smetana
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam ArrowColor #475569
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #60A5FA

title LLM-EdgeFlow 当前配置与运行流程
legend bottom
  文件名沿用 architecture_v2.puml；内容描述当前实现。
  箭头表示准备、创建或调用关系，不表示编译依赖。
  可用 Node、Model、Backend 与 Biz 以目标构建 Catalog 为准。
endlegend

actor "宿主程序 / 统一 Demo" as Caller
component "CLI / Pipeline Studio" as Tools

package "方案与注册信息" {
  artifact ".conf\n仅 pipe_path" as Conf
  artifact "Pipeline JSON\n节点 / depends_on / typed ports / models\ndeployment.io / deployment.model_paths" as Document
  component "PipelineCatalog\n注册 Definition 的查询视图" as Catalog
  component "Node Spec + 普通算法函数\nREGISTER_FUNCTION_NODE\nModel / Backend / I/O 注册" as Definitions
}

package "创建期：接入准备与统一校验" {
  component "PrepareDeploymentDocument\n接入绑定 / 路径覆盖 / 输出分配参数" as Prepare
  artifact "PreparedDeployment\n中性 Pipeline JSON + PipelineIoBoundary" as Prepared
  component "PipelineValidator\n显式 DAG / 类型端口 / 并发写冲突" as Validator
  artifact "ValidatedPipelinePlan" as PipelinePlan
  artifact "ValidatedIoPlan\nI/O Definition 与端口映射\n输出池规格 + Pipeline 计划" as IoPlan
}

package "运行期：C++ Operator SDK" {
  component "OperatorFunc\nCreate / Process / Control / Destroy\n命名槽位校验 / 输出租约 / 异常屏障" as Operator
  component "SharedAlgorithmRuntime" as Runtime
  component "InputConverterDefinition::decode_fn\n完整请求 → 中性输入与元信息" as Decode
  component "OutputConverterDefinition::encode_fn\n内部结果 → 完整响应与容量检查" as Encode
  component "Pipeline\nBuildFromPlan / Execute / Control\n消费已验证计划" as Pipeline
  component "AlgContext\nBlackboardKey<T> / Read / Publish\n请求内不可变快照" as Context
  component "SessionContext\nModelManager / SessionResourceKey<T>" as Session
  component "NodeBase → AuthorNode<Spec>\n通用 Node 与自定义 Node\ntyped I/O / 参数 / 模型 / Control" as Nodes
}

package "模型执行（按需）" {
  component "ModelRuntimeFactory\nModelRegistry + BackendRegistry" as Factory
  component "IModel 能力\nEmbed / Score / Generate / Recognize / Transcribe" as Model
  component "中性 Backend 会话\nTensorGraph / TextGeneration / ImageTextGeneration\nGeneratedTokenEmbedding / AudioTranscription" as Backend
  component "FixedBatchExecutor\nchunk / pad / strip\nreq_id / sub_id" as Batch
}

Tools --> Catalog : 查询
Definitions --> Catalog : 提供 Definition
Tools --> Document : 编辑 / 保存
Conf --> Document : 定位
Document --> Prepare
Prepare --> Prepared
Prepared --> Validator
Catalog --> Validator : 能力与配置契约
Validator --> PipelinePlan
Prepared --> IoPlan : 接入信息
PipelinePlan --> IoPlan
Caller --> Operator : NamedIoBatch
Operator --> IoPlan : 创建期解析部署
IoPlan --> Runtime : 创建
Runtime *-- Pipeline
IoPlan --> Pipeline : 转移 ValidatedPipelinePlan
Pipeline *-- Session
Pipeline --> Factory : 创建期物化模型
Factory --> Model
Factory --> Backend
Session o-- Model
Operator --> Decode : Process 校验输入
Decode --> Context : 发布
Operator --> Pipeline : Execute
Pipeline --> Nodes : 依拓扑执行
Nodes --> Context : 读取 / 发布
Nodes --> Model : 调用声明能力
Model --> Backend : 推理
Model --> Batch : 固定批次执行
Operator --> Encode : 执行成功后编码
Context --> Encode : 读取结果与元信息
Encode --> Operator : 编码完成 / written_count
Operator --> Caller : 发布输出池租约
@enduml
