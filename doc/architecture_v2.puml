@startuml LLM_EdgeFlow_Target_Architecture_V2
!pragma layout smetana
!theme plain

title LLM-EdgeFlow Target Architecture V2\nDeveloper-Friendly & AI-Friendly Business Delivery Platform

legend top right
  |= State |= Meaning |
  | Implemented | implemented and covered by repository tests |
  | Partial | implemented core, remaining RFC acceptance work |
  | Planned | not implemented in RFC 0008 |
endlegend

skinparam backgroundColor #0F172A
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8
skinparam shadowing true
skinparam dpi 300
skinparam package {
  BackgroundColor #1E293B
  BorderColor #475569
  FontColor #F8FAFC
  FontStyle bold
}
skinparam component {
  BackgroundColor #0F172A
  BorderColor #0284C7
  FontColor #F1F5F9
}
skinparam interface {
  BackgroundColor #0F172A
  BorderColor #10B981
  FontColor #A7F3D0
}
skinparam artifact {
  BackgroundColor #0F172A
  BorderColor #F59E0B
  FontColor #FDE68A
}
skinparam actor {
  BackgroundColor #0F172A
  BorderColor #38BDF8
  FontColor #E0F2FE
}
skinparam arrow {
  Color #38BDF8
  FontColor #CBD5E1
  FontSize 9
}

' Users and ownership boundaries
actor "Downstream C Caller" as Caller
actor "Platform Scheduler" as PlatformScheduler
actor "Pipeline Composer" as Composer
actor "Business Developer" as BizDev
actor "AI Agent" as AIAgent
actor "Platform Developer" as PlatformDev

' Machine-readable control plane
package "Control Plane: Business Development Surface" as ControlPlane {
  artifact "Business Manifest\nJSON Schema" as Manifest <<Planned>>
  artifact "Pipeline Config\nExplicit DAG JSON" as PipelineConfig <<Implemented>>
  artifact "Node / Model / Backend / Business Catalog\nPipelineCatalog (JSON Export)" as Catalog <<Implemented>>
  component "Business Scaffolder\nTemplates" as Scaffolder <<Planned>>
  component "Static Validator\nPipelineValidator" as Validator <<Partial>>
  component "Business Test Harness\nGoogleTest Suites / CTest" as BizTests <<Implemented>>
}

Composer --> PipelineConfig : compose
BizDev --> Scaffolder : create business
AIAgent --> Scaffolder : generate scaffold
AIAgent --> PipelineConfig : generate / modify
PlatformDev --> Catalog : publish capabilities
Scaffolder --> Manifest : generate
Scaffolder --> PipelineConfig : generate
Manifest --> Validator
PipelineConfig --> Validator
Catalog --> Validator
Validator --> BizTests : validated package

' Layer 1
package "Layer 1: Dual Facades & Shared Algorithm Runtime" as L1 {
  component "Pure C ABI Facade\n6 lifecycle APIs\nnoexcept exception firewall" as CAbi <<C ABI>>
  component "Operator Facade\nOperatorFunc + NamedIoBatch\nCompanyConfResolver\nOperatorBizBridgeRegistry" as PlatformFacade <<Operator API>>
  component "Shared Algorithm Runtime\nSharedAlgorithmRuntime\nSingle Unpack-Execute-Pack" as SharedRuntime
  artifact "Business-Specific\nPure C Structs" as CStructs
  component "BizAdapterRegistry" as AdapterRegistry
  interface "IBizAdapter\nDescriptor / ValidateBatch\nUnpack / Pack" as IBizAdapter
  component "Biz Adapters\nStatically Linked" as BizAdapters
  artifact "Common Typed Contracts" as CommonContracts
}

Caller --> CAbi : pure C calls
PlatformScheduler --> PlatformFacade : OperatorFunc calls
PlatformFacade --> SharedRuntime : convert NamedIo to C ptrs
CAbi --> SharedRuntime : forward C params
SharedRuntime --> AdapterRegistry : dispatch by business_id / name
AdapterRegistry o-- IBizAdapter
BizAdapters ..|> IBizAdapter
BizAdapters --> CStructs : validate / unpack / pack
BizAdapters --> CommonContracts : map to typed values
Manifest --> AdapterRegistry : registration metadata
Scaffolder --> BizAdapters : generate scaffold

' Layer 2
package "Layer 2: Validated Pipeline Runtime & State" as L2 {
  component "PipelineBuilder\nPipeline::BuildFromJson" as PipelineBuilder
  component "PipelineStaticValidator\nPipelineValidator\nDAG / ports / producers / parallel conflicts" as PipelineValidator
  component "Pipeline Runtime\nsequential / parallel wavefront" as PipelineRuntime
  component "Typed Port Access\nBlackboardKey<T>" as TypedPorts <<Implemented>>
  component "Request Blackboard\nAlgContext" as RequestContext <<Implemented>>
  component "SessionContext" as SessionContext
  component "ModelManager" as ModelManager
  artifact "RuntimeOptions\nmodel root / device / limits" as RuntimeOptions
  component "Structured Status\nPipelineDiagnostic / AdapterStatus" as Status
}

Validator --> PipelineBuilder : validated definitions
PipelineBuilder --> PipelineValidator
PipelineValidator --> PipelineRuntime : executable plan
PipelineRuntime --> TypedPorts
TypedPorts --> RequestContext
PipelineRuntime *-- SessionContext
SessionContext *-- ModelManager
SessionContext o-- RuntimeOptions
PipelineRuntime --> Status : structured failures
BizAdapters --> RequestContext : inject / extract
CommonContracts --> RequestContext

' Layer 3
package "Layer 3: Contracted Operator Layer" as L3 {
  interface "INode\nInit / Process / Control / Name" as INode
  component "NodeBase\nfinal noexcept lifecycle" as NodeBase <<Implemented>>
  component "ModelBoundNode / TraceableUnaryInferenceNode" as NodeSupport <<Implemented>>
  component "NodeRegistry\n(NodeFactory)" as NodeRegistry
  component "Registered\nCommon Nodes" as CommonNodes
  component "Optional Domain Node\n(none currently registered)" as DomainNodes
  artifact "NodeDescriptor\n(NodeDefinition in Catalog)" as NodeDescriptor
}

NodeRegistry o-- INode
INode <|-- NodeBase
NodeBase <|-- NodeSupport
CommonNodes ..|> INode
DomainNodes ..|> INode
NodeDescriptor --> NodeRegistry : registration metadata
Catalog o-- NodeDescriptor
PipelineBuilder --> NodeRegistry : create nodes
INode --> TypedPorts : declared access only
INode --> SessionContext : models / resources
BizTests --> CommonNodes : composition contract tests

note right of DomainNodes
  Request state only in RequestContext
  No Layer 1 C structs
  No concrete Backend implementations
  Requires RFC justification
end note

' Layer 4
package "Layer 4: Model Semantics & Inference Backends" as L4 {
  interface "IModel\nIEmbeddingModel / IRerankModel / ILlmModel\nIOcrModel / IAsrModel" as IModel
  interface "IBackendSession\nTensorGraph / CausalLm protocols" as IBackendSession
  interface "IInferenceBackend\nloads backend sessions" as IInferenceBackend
  component "ModelRegistry" as ModelRegistry
  component "BackendRegistry" as BackendRegistry
  component "ModelRuntimeFactory\ncompose model_type + backend" as ModelRuntimeFactory
  component "FixedBatchExecutor\nchunk / pad / strip\nreq_id / sub_id provenance" as FixedBatchExecutor
  component "BGE Embedding / Reranker Models" as BgeModels
  component "Qwen Causal LM Model" as QwenModel
  component "ONNX Runtime Backend" as OnnxBackend
  component "llama.cpp Backend" as LlamaBackend
  component "Future Hardware Backends" as FutureBackends
  artifact "ModelDefinition / BackendDefinition\nprotocol + concurrency contracts" as InferenceDescriptors <<Implemented>>
}

ModelRegistry o-- IModel
BackendRegistry o-- IInferenceBackend
IInferenceBackend --> IBackendSession : load
InferenceDescriptors --> ModelRegistry : model metadata
InferenceDescriptors --> BackendRegistry : backend metadata
Catalog o-- InferenceDescriptors
PipelineBuilder --> ModelRuntimeFactory : create models
ModelRuntimeFactory --> ModelRegistry
ModelRuntimeFactory --> BackendRegistry
ModelManager o-- IModel
INode --> IModel : capability interfaces only
BgeModels ..|> IModel
QwenModel ..|> IModel
OnnxBackend ..|> IInferenceBackend
LlamaBackend ..|> IInferenceBackend
FutureBackends ..|> IInferenceBackend
BgeModels --> IBackendSession : TensorGraph protocol
QwenModel --> IBackendSession : CausalLm protocol
BgeModels --> FixedBatchExecutor
QwenModel --> FixedBatchExecutor

note right of L4
  Platform-owned extension surface
  Business developers do not modify by default
end note

' Cross-cutting contracts
package "Cross-Cutting Platform Contracts" as CrossCutting {
  component "Version & Compatibility" as Versioning
  component "Observability\nLogs / Metrics / Traces" as Observability
  component "Layer Dependency Guard" as LayerGuard
  component "Ownership & Review Policy" as Ownership
}

Versioning ..> Manifest
Versioning ..> CAbi
Versioning ..> NodeDescriptor
Versioning ..> InferenceDescriptors
Observability ..> CAbi
Observability ..> PipelineRuntime
Observability ..> IModel
Observability ..> IInferenceBackend
LayerGuard ..> L1
LayerGuard ..> L2
LayerGuard ..> L3
LayerGuard ..> L4
Ownership ..> Composer
Ownership ..> BizDev
Ownership ..> AIAgent
Ownership ..> PlatformDev

note bottom of ControlPlane
  Phase 1 packaging:
  single repository + static linking
  no dynamic plugin ABI yet
end note

@enduml
