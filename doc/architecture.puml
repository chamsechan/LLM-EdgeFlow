@startuml LLM_EdgeFlow_Architecture
!pragma layout smetana
!theme plain
skinparam backgroundColor #0F172A
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam roundCorner 8
skinparam shadowing true
skinparam dpi 300

skinparam package {
  BackgroundColor #1E293B
  BorderColor #475569
  FontColor #F8FAFC
  FontSize 13
  FontStyle bold
}

skinparam class {
  BackgroundColor #0F172A
  BorderColor #0284C7
  FontColor #F1F5F9
  AttributeFontColor #94A3B8
  FontSize 11
  AttributeFontSize 10
}

skinparam interface {
  BackgroundColor #0F172A
  BorderColor #10B981
  FontColor #A7F3D0
  AttributeFontColor #94A3B8
  FontSize 11
}

skinparam arrow {
  Color #38BDF8
  FontColor #CBD5E1
  FontSize 9
}

' ==============================================================================
' Layer 1: C ABI 适配层与平台门面
' ==============================================================================
package "Layer 1: 双门面与 C ABI 安全适配层 (Dual Facades & C Adapter)" as L1 {
  class "Company C ABI Exports" as C_ABI <<(C,#0284C7) API Export>> {
    + Alg_Init(): int noexcept
    + Alg_Create(void** hndl, const CompanyAlgParamCreate*): int noexcept
    + Alg_Process(void* hndl, const void** in, int num_in, void** out, int* num_out): int noexcept
    + Alg_Control(void* hndl, const CompanyAlgParamControl*): int noexcept
    + Alg_Destroy(void* hndl): int noexcept
    + Alg_DeInit(): int noexcept
  }

  class "Operator Facade" as PlatformFacade <<(P,#38BDF8) Operator API>> {
    + Get_LLM_EDGEFLOW_OperatorTable(): OperatorFunc
    + CompanyConfResolver: resolve .conf & rewrite model paths
    + OperatorValueTypeRegistry: value type whitelist & pool sizing
    + OperatorBizBridgeRegistry: biz bridge slots & conversion
    + OperatorControlRegistry: typed control commands
  }

  class "SharedAlgorithmRuntime" as SharedRuntime <<(R,#10B981) Shared Runtime>> {
    - pipeline_: std::unique_ptr<Pipeline>
    - adapter_: std::shared_ptr<IBizAdapter>
    + ExecuteBatch(inputs, num_inputs, outputs, num_outputs, err): int
    + ExecuteControl(cmd, json_param, err): int
  }

  class "AlgHandleInstance" as HandleInst {
    + runtime: std::unique_ptr<SharedAlgorithmRuntime>
  }

  class "BizAdapterRegistry" as AdapterRegistry <<(S,#EC4899) Singleton>> {
    + Register(type: int, adapter: shared_ptr<IBizAdapter>): void
    + Get(type: int): std::shared_ptr<IBizAdapter>
    + HasConflict(): bool
  }

  interface "IBizAdapter" as IAdapter {
    + {abstract} GetDescriptor(): AdapterDescriptor
    + {abstract} ValidateBatch(in, num_in, out, num_out, status): bool
    + {abstract} Unpack(in, num_in, ctx, status): bool
    + {abstract} Pack(ctx, out, num_out, status): bool
  }

  class "AdapterValidationHelper" as ValidationHelper {
    + {static} CheckedStringCopy(src, dst, max_len, status): bool
    + {static} RequireBoundedString(str, max_len, status): bool
  }

  class "Multi-Modal C Structs" as Structs <<(S,#F59E0B) Data Struct>> {
    + CompanyDocInput / Output (Biz 1)
    + CompanyKeywordInput / Output (Biz 2)
    + CompanyEntityInput / Output (Biz 3)
    + CompanyAuditInput / Output (Biz 4)
    + CompanyOcrDocInput / Output (Biz 5)
    + CompanyAudioInput / Output (Biz 6)
    + CompanyRerankBatchInput / Output (Biz 7)
  }
}

' ==============================================================================
' Layer 2: 框架调度与黑板层
' ==============================================================================
package "Layer 2: 核心编排与动态黑板层 (Pipeline & Blackboard)" as L2 {
  class Pipeline {
    - nodes_: std::vector<std::unique_ptr<INode>>
    - session_context_: SessionContext
    - business_name_: std::string
    - state_: State {kEmpty, kBuilding, kReady, kFailed}
    - execution_layers_: std::vector<std::vector<size_t>>
    + BuildFromConfigFile(config_path: string): bool
    + BuildFromJson(root_config: json): bool
    + Execute(req_ctx: AlgContext*): int
    + Control(cmd: int, json_param: string): int
  }

  class PipelineValidator <<(V,#0284C7) Static Validator>> {
    + {static} ValidateAndPlan(json_obj, policy): ValidatedPipelinePlan
    + {static} Validate(json_obj, policy): ValidationReport
    + {static} NormalizeExplicitDag(json_obj): json
  }

  class ValidatedPipelinePlan <<(P,#38BDF8) Immutable Plan>> {
    + report: ValidationReport
    + config: ParsedPipelineConfig
    + topological_order: vector<string>
    + topological_layers: vector<vector<string>>
  }

  class AlgContext <<(B,#10B981) Request Blackboard>> {
    - blackboard_: std::unordered_map<string, std::any>
    - mutable rw_mutex_: std::shared_mutex
    - error_code_: int
    - error_message_: std::string
    + Set<T>(key: BlackboardKey<T>, value: T): void
    + Get<T>(key: BlackboardKey<T>): const T*
    + Has<T>(key: BlackboardKey<T>): bool
    + SetError(code: int, msg: string): void
    + Clear(): void
  }

  class SessionContext {
    - model_manager_: ModelManager
    - runtime_options_: RuntimeOptions
    + GetModelManager(): ModelManager&
    + GetRuntimeOptions(): const RuntimeOptions&
  }

  class ModelManager {
    - models_: map<string, ModelRegistration>
    + RegisterBatch(models): bool
    + GetModel<T>(id: string): std::shared_ptr<T>
    + HasModel(id: string): bool
  }

  class "TraceableItem<T>" as TraceableItem <<(T,#8B5CF6) Data Container>> {
    + req_id: uint64_t
    + sub_id: uint32_t
    + data: T
  }
}

' ==============================================================================
' Layer 3: 通用能力节点
' ==============================================================================
package "Layer 3: 通用能力节点 (Stateless Capability Nodes)" as L3 {
  interface INode {
    + {abstract} Init(config: json, session_ctx: SessionContext*): bool
    + {abstract} Process(req_ctx: AlgContext*): int
    + {abstract} Control(cmd: int, json_param: const string&): int
    + {abstract} Name(): const string&
  }

  class NodeBase <<(B,#38BDF8) Base Class>> {
    # {abstract} ProcessNode(req_ctx: AlgContext&): int
    # {abstract} InitNode(config, session_ctx): bool
    # Require<T>(ctx, key, err_code): const T*
    # Publish<T>(ctx, key, val): void
    # Fail(ctx, err_code, msg): int
  }

  class "ModelBoundNode<E>" as ModelBoundNode <<(M,#10B981) Model Template>> {
    # model(): shared_ptr<E>
    # model_id(): const string&
  }

  class "TraceableUnaryInferenceNode<E, In, Out>" as TraceableUnaryNode <<(U,#8B5CF6) Unary Template>> {
    # {abstract} InferBatch(in: InputBatch, out: OutputBatch*): int
  }

  class NodeFactory <<(S,#EC4899) Singleton>> {
    + {static} Instance(): NodeFactory&
    + Register(type: string, creator: Func): void
    + Create(type: string): std::unique_ptr<INode>
    + HasConflict(): bool
  }

  class "Registered Common Nodes\n(query PipelineCatalog for exact list)" as CommonNodes
}

' ==============================================================================
' Layer 4: 模型语义与推理 Backend 层
' ==============================================================================
package "Layer 4: 模型语义与推理 Backend 层 (Model & Backend)" as L4 {
  interface IModel {
    + {abstract} ModelType(): const string&
    + {abstract} Capability(): const string&
    + {abstract} Concurrency(): InferenceConcurrency
    + {abstract} GetMaxBatchSize(): size_t
  }

  interface IEmbeddingModel {
    + {abstract} Embed(inputs: TextBatch, options, outputs): int
  }

  interface IRerankModel {
    + {abstract} Score(inputs: QueryCandidatesBatch, outputs: ScoreBatch*): int
  }

  interface ILlmModel {
    + {abstract} Generate(prompts: TextBatch, options, outputs: TextBatch*): int
  }

  interface IOcrModel {
    + {abstract} Recognize(images: ImageRefBatch, outputs: OcrDocumentBatch*): int
  }

  interface IAsrModel {
    + {abstract} Transcribe(audio: AudioPcmBatch, outputs: TextBatch*): int
  }

  interface IBackendSession {
    + {abstract} BackendType(): const string&
    + {abstract} Protocol(): ExecutionProtocol
    + {abstract} Concurrency(): InferenceConcurrency
    + {abstract} GetBatchPolicy(): BatchPolicy
  }

  interface ITensorGraphSession {
    + {abstract} Inputs(): vector<TensorSpec>
    + {abstract} Outputs(): vector<TensorSpec>
    + {abstract} Run(inputs: TensorMap, outputs: TensorMap*): int
  }

  interface ICausalLmSession {
    + {abstract} TokenCodec(): ITokenCodec&
    + {abstract} MaxContextTokens(): size_t
    + {abstract} CreateSequence(): unique_ptr<ICausalLmSequence>
  }

  interface ICausalLmSequence {
    + {abstract} Evaluate(tokens, logits): int
  }

  interface IInferenceBackend {
    + {abstract} BackendType(): const string&
    + {abstract} Load(spec: BackendLoadSpec): shared_ptr<IBackendSession>
  }

  class ModelRegistry <<(S,#EC4899) Singleton>> {
    + Register(definition: ModelDefinition, creator): bool
    + Create(model_type: string, context): shared_ptr<IModel>
  }

  class BackendRegistry <<(S,#EC4899) Singleton>> {
    + Register(definition: BackendDefinition, creator): bool
    + Create(backend_type: string): unique_ptr<IInferenceBackend>
  }

  class ModelRuntimeFactory {
    + {static} Create(config, runtime_options): ModelRegistration
  }

  class BgeEmbeddingModel
  class BgeRerankerModel
  class QwenCausalLmModel
  class OnnxRuntimeBackend
  class LlamaCppBackend

  class FixedBatchExecutor <<(T,#F59E0B) Generic Template>> {
    + {static} Execute<TIn, TOut>(inputs, policy: BatchPolicy, callback: BatchSlice, outputs): int
  }
}

' ==============================================================================
' Platform Tooling & Visualizer Studio
' ==============================================================================
package "Platform Tooling & Visualizer Studio (Tools & Demo)" as Tools {
  class "alg_pipeline_tool (CLI)" as PipelineTool <<(T,#38BDF8) C++ Tool>> {
    + catalog / describe-node / init / normalize / validate / plan
  }
  class "alg_show (CLI)" as AlgShow <<(T,#38BDF8) C++ Tool>> {
    + Native ASCII DAG print
  }
  class "Web Visualizer Studio" as WebStudio <<(W,#10B981) Web App>> {
    + ./show --web (ES Modules + SVG Graph + Live Demo Draft)
  }
  class "Parameterized Demo Runner" as DemoRunner <<(D,#F59E0B) Demo Suite>> {
    + profiles.json (Single source of truth)
    + OperatorRunner (RAII lifecycle execution)
    + ResultWriter (JSONL / Summary persistence)
  }
}

' ==============================================================================
' 关系连接与流向
' ==============================================================================
C_ABI ..> HandleInst : 管理生命周期
C_ABI ..> Structs : 解包/填充
PlatformFacade ..> SharedRuntime : 命名 I/O 适配
HandleInst *-- SharedRuntime
SharedRuntime *-- Pipeline
SharedRuntime o-- AdapterRegistry
AdapterRegistry o-- IAdapter
IAdapter ..> ValidationHelper : 严格容量与截断防护

Pipeline *-- SessionContext
Pipeline *-- INode : 显式 DAG 拓扑执行
Pipeline ..> PipelineConfig : 强类型解析
Pipeline ..> PipelineValidator : 静态校验与规范化
SessionContext *-- ModelManager
ModelManager o-- IModel

INode <|-- NodeBase
NodeBase <|-- ModelBoundNode
ModelBoundNode <|-- TraceableUnaryNode
NodeBase <|.. CommonNodes
NodeFactory ..> INode : 动态反射创建 (Fail-Closed)

CommonNodes ..> AlgContext : Typed Key 读写
ModelBoundNode ..> ModelManager : 索取纯虚能力接口

IModel <|-- IEmbeddingModel
IModel <|-- IRerankModel
IModel <|-- ILlmModel
IModel <|-- IOcrModel
IModel <|-- IAsrModel
IEmbeddingModel <|.. BgeEmbeddingModel
IRerankModel <|.. BgeRerankerModel
ILlmModel <|.. QwenCausalLmModel

IBackendSession <|-- ITensorGraphSession
IBackendSession <|-- ICausalLmSession
ICausalLmSession ..> ICausalLmSequence : 创建独立执行序列
IInferenceBackend <|.. OnnxRuntimeBackend
IInferenceBackend <|.. LlamaCppBackend
OnnxRuntimeBackend ..> ITensorGraphSession : 创建中性协议会话
LlamaCppBackend ..> ICausalLmSession : 创建 Causal LM 会话
BgeEmbeddingModel ..> ITensorGraphSession : 仅依赖 Tensor 协议
BgeRerankerModel ..> ITensorGraphSession : 仅依赖 Tensor 协议
QwenCausalLmModel ..> ICausalLmSession : codec / context 上限
QwenCausalLmModel ..> ICausalLmSequence : token evaluate

ModelRuntimeFactory ..> BackendRegistry : backend 创建与加载
ModelRuntimeFactory ..> ModelRegistry : model 语义对象创建
BackendRegistry ..> IInferenceBackend : 自描述注册 (Fail-Closed)
ModelRegistry ..> IModel : 自描述注册 (Fail-Closed)

BgeEmbeddingModel ..> FixedBatchExecutor : 定长分批与溯源
BgeRerankerModel ..> FixedBatchExecutor : 定长分批与溯源
QwenCausalLmModel ..> FixedBatchExecutor : 批次切分与溯源
FixedBatchExecutor ..> TraceableItem : 样本切块/补齐/剥离/溯源

WebStudio ..> PipelineTool : 交互式编排调用
Tools ..> L1 : 驱动 Demo 与 Operator API
Tools ..> L2 : 静态校验与拓扑规划

@enduml
