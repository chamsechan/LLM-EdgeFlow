@startuml LLM_EdgeFlow_Architecture
!pragma layout smetana
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK SC"
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #475569
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #60A5FA

title LLM-EdgeFlow 当前实现：主要类型与职责
legend bottom
  仅列主要类型、成员与操作；省略参数时不表示完整 C++ 签名。
  关系表示类型使用与所有权，不替代 CMake 编译依赖边界。
endlegend

package "接入适配层 / Integration" {
  class "C++ Operator SDK" as Operator {
    Get_LLM_EDGEFLOW_OperatorTable()
    GetOperatorLastError()
    ResolveOperatorConfigBiz()
    OperatorFunc: Init / Create / Process
    Control / Destroy / DeInit
  }
  class OperatorHandle {
    runtime: owns SharedAlgorithmRuntime
    output_pools: pool state per slot
    mutex: serializes Process / Control
  }
  class SharedAlgorithmRuntime {
    io_plan_: unique_ptr<ValidatedIoPlan>
    pipeline_: unique_ptr<Pipeline>
    CreateFromIoPlan(): int
    ExecuteControl(): int
  }
  class ValidatedIoPlan {
    binding: IoBindingDefinition
    input_converter: Definition pointer
    output_converter: Definition pointer
    pipeline_plan: owns ValidatedPipelinePlan
    构建时移交 Pipeline，运行时为空
  }
  class IoBindingResolver {
    ResolveFromFile()
    ResolveFromPipelineJson()
  }
  class "PrepareDeploymentDocument()" as PrepareDeployment
  class IoBindingRegistry {
    RegisterBinding()
    RegisterExposure()
    Audit()
  }
  class IoConverterRegistry {
    RegisterInputConverter(definition)
    RegisterOutputConverter(definition)
    FindInputConverter(id)
    FindOutputConverter(id)
  }
  class InputConverterDefinition {
    external_slots / logical_ports
    decode_fn: DecodeInputFn
  }
  class OutputConverterDefinition {
    logical_ports / external_slots
    encode_fn: EncodeOutputFn
  }
  class "NamedIoBatch / Company* DTO" as ExternalIo
}

package "流程编排层 / Orchestration" {
  class PipelineValidator {
    ValidateAndPlan(): ValidatedPipelinePlan
    Validate(): ValidationReport
  }
  class ValidatedPipelinePlan {
    config: ParsedPipelineConfig
    models: vector<ValidatedModelPlan>
    node_plans: ValidatedNodePlan by node id
    report: ValidationReport
  }
  class Pipeline {
    plan_: unique_ptr<ValidatedPipelinePlan>
    session_ctx_: unique_ptr<SessionContext>
    BuildFromPlan(): bool
    Execute(AlgContext*): int
    Control(cmd, json_param, error): int
  }
  class AlgContext {
    Publish<T>(BlackboardKey<T>, value): bool
    Read<T>(BlackboardKey<T>): const T*
    SetError(code, message)
  }
  class SessionContext {
    GetModelManager(): ModelManager&
    GetOrCreateResource<T>()
  }
  class ModelManager {
    RegisterBatch(registrations): bool
    GetModel<T>(id): shared_ptr<T>
  }
  class PipelineCatalog {
    Node / Model / Backend / Biz Definition snapshots
  }
}

package "能力节点层 / Capability Nodes" {
  interface INode {
    Init(NodeInitContext): bool
    Process(AlgContext*): int
    Control(): NodeControlResult
    Name(): const string&
  }
  class NodeBase {
    Init(): final noexcept
    Process(): final noexcept
    Control(): exception barrier
  }
  class "AuthorNode<Spec>" as AuthorNode {
    typed InputsOf / OutputsOf / ModelsOf
    Parameters / ConfigurationSnapshot
    ordinary algorithm function
  }
  class NodeRegistry {
    Register(): bool
    Create(type): unique_ptr<INode>
  }
  class "通用与自定义 Spec\nREGISTER_FUNCTION_NODE" as Specs
}

package "模型执行层 / Model Execution" {
  interface IModel
  class "模型能力接口\nIEmbeddingModel / IRerankModel\nILlmModel / IOcrModel / IAsrModel" as Capabilities
  class "模型语义\nBgeEmbeddingModel / BgeRerankerModel\nQwenCausalLmModel\nGeneratedTextEmbeddingModel\nVisionDocumentModel / WhisperAsrModel" as Models
  class ModelRegistry
  class ModelRuntimeFactory {
    Create(): shared_ptr<IModel>
  }
  class BackendRegistry
  interface IInferenceBackend {
    Load(): shared_ptr<IBackendSession>
  }
  interface IBackendSession {
    Protocol() / Concurrency() / GetBatchPolicy()
  }
  class "中性执行协议\nITensorGraphSession / ITextGenerationSession\nIImageTextGenerationSession\nIGeneratedTokenEmbeddingSession\nIAudioTranscriptionSession" as Sessions
  class "可选 Backend\nOnnxRuntimeBackend / LlamaCppBackend\nKiteLlmBackend / WhisperCppBackend" as Backends
  class FixedBatchExecutor {
    Execute(inputs, policy, callback, outputs)
    chunk / pad / strip / validate provenance
  }
}

Operator ..> ExternalIo : 命名槽位与输出租约
Operator ..> OperatorHandle : 生命周期
OperatorHandle *-- SharedAlgorithmRuntime
SharedAlgorithmRuntime *-- ValidatedIoPlan
SharedAlgorithmRuntime *-- Pipeline
Operator ..> IoBindingResolver : Create / 配置预检
IoBindingResolver ..> PrepareDeployment
PrepareDeployment ..> IoBindingRegistry
PrepareDeployment ..> IoConverterRegistry
IoBindingResolver ..> PipelineValidator : 中性文档与 I/O 边界
IoBindingResolver ..> ValidatedIoPlan : 组装
IoConverterRegistry o-- InputConverterDefinition
IoConverterRegistry o-- OutputConverterDefinition
Operator ..> InputConverterDefinition : decode_fn
Operator ..> OutputConverterDefinition : encode_fn
InputConverterDefinition ..> AlgContext : 发布输入与请求元信息
OutputConverterDefinition ..> AlgContext : 读取结果并组装响应
PipelineValidator ..> PipelineCatalog : 注册 Definition
PipelineValidator ..> ValidatedPipelinePlan : 生成
Pipeline *-- ValidatedPipelinePlan : 消费计划所有权
Pipeline *-- SessionContext
SessionContext *-- ModelManager
Pipeline *-- INode : 顺序 / 波前执行
Pipeline ..> NodeRegistry : 创建
INode <|-- NodeBase
NodeBase <|-- AuthorNode
Specs ..> AuthorNode : 实例化运行时
Specs ..> NodeRegistry : 生成 Definition 并注册
AuthorNode ..> AlgContext : typed ports
AuthorNode ..> ModelManager : 声明的模型能力
IModel <|-- Capabilities
Capabilities <|.. Models
ModelManager o-- IModel
Pipeline ..> ModelRuntimeFactory : 物化已验证模型计划
ModelRuntimeFactory ..> ModelRegistry
ModelRuntimeFactory ..> BackendRegistry
ModelRegistry ..> Models : 创建
BackendRegistry ..> Backends : 创建
IInferenceBackend <|.. Backends
Backends ..> Sessions : 加载
IBackendSession <|-- Sessions
Models ..> Sessions : 仅依赖中性协议
Models ..> FixedBatchExecutor : 保留 req_id / sub_id
@enduml
