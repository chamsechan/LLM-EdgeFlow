@startuml LLM_EdgeFlow_Architecture
!pragma layout smetana
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundCorner 8
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam ArrowColor #475569
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #94A3B8
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #94A3B8
hide empty members

title LLM-EdgeFlow：主要类型与所有权
legend bottom
  ◆ 持有所有权　◇ 共享持有
  虚线箭头：使用或创建　空心三角：继承
  只画主要关系；编译依赖与创建顺序分别见架构正文和时序图。
endlegend

package "接入适配层 / Integration" as Integration #EFF6FF {
  class SharedAlgorithmRuntime {
    由 OperatorHandle 持有
    持有 ValidatedIoPlan：转换器、端口、参数
    持有各输出槽的 OutputPoolState
    Process / Control 串行
  }
}

package "流程编排层 / Orchestration" as Orchestration #F0FDF4 {
  class Pipeline {
    接管 ValidatedPipelinePlan
    BuildFromPlan / Execute
  }
  class SessionContext {
    ModelManager 与类型资源缓存
  }
  class AlgContext {
    每次 Process 新建
    类型端口 Read / Publish
  }
  class NodeRegistry
  interface INode
}

package "能力节点层 / Capability Nodes" as Nodes #FFF7ED {
  class NodeBase {
    生命周期与异常屏障
  }
  class "AuthorNode（Spec）" as AuthorNode {
    通用 / 自定义算法使用同一结构
    类型端口、参数、模型绑定与 Run
  }
}

package "模型执行层 / Model Execution" as Execution #F5F3FF {
  class "具体 Model\n实现 IModel 及所需能力接口" as Model {
    预后处理与输出语义
  }
  interface IBackendSession {
    由 IInferenceBackend::Load 创建
    中立执行协议、并发能力与批策略
  }
  class FixedBatchExecutor {
    Execute / ExecuteItems
    数量校验、来源恢复、失败清空
  }
}

SharedAlgorithmRuntime *-- Pipeline
SharedAlgorithmRuntime ..> AlgContext : 请求上下文
Pipeline *-- SessionContext
Pipeline *-- INode : 节点实例
Pipeline ..> NodeRegistry : 创建节点
NodeRegistry ..> INode : 工厂接口
NodeBase -up-|> INode
AuthorNode -up-|> NodeBase
AuthorNode ..> AlgContext : 读取 / 发布
AuthorNode ..> Model : 调用声明能力
SessionContext o-- Model
Model o-- IBackendSession : 持有会话
Model ..> FixedBatchExecutor : 批处理

Integration -[hidden]down-> Orchestration
Orchestration -[hidden]down-> Nodes
Nodes -[hidden]down-> Execution
@enduml
