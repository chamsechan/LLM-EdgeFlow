{
  "deployment": {
    "model_paths": {
      "embed_model_v1": "./models/bge_base_zh_v1.5.onnx",
      "rerank_model_v1": "./models/ms_marco_tinybert_l2_v2_quantized.onnx",
      "llm_model_v1": "./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    },
    "io": {
      "io_binding": "doc_qa.operator.v1"
    }
  },
  "models": [
    {
      "model_type": "bge_embedding",
      "backend": "onnxruntime",
      "model_config": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "embedding_dim": 768
      },
      "backend_config": {
        "max_batch_size": 4
      },
      "model_id": "embed_model_v1",
      "model_path": "bge_base_zh_v1.5.onnx"
    },
    {
      "model_type": "bge_reranker",
      "backend": "onnxruntime",
      "model_config": {
        "tokenizer_file": "ms_marco_bert_vocab.txt",
        "max_batch_size": 4
      },
      "backend_config": {
        "max_batch_size": 4
      },
      "model_id": "rerank_model_v1",
      "model_path": "ms_marco_tinybert_l2_v2_quantized.onnx"
    },
    {
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_config": {
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 1024,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      },
      "model_id": "llm_model_v1",
      "model_path": "qwen2.5-0.5b-instruct-q4_k_m.gguf"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "config": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "raw_docs"
      },
      "outputs": {
        "chunks": "doc_chunks",
        "chunk_counts": "doc_chunk_counts"
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_v1"
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "embedding": "query_embeddings"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_v1"
      },
      "inputs": {
        "text": "doc_chunks"
      },
      "outputs": {
        "embedding": "chunk_embeddings"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "config": {
        "min_score": 0.0,
        "top_k": 4
      },
      "inputs": {
        "queries": "query_embeddings",
        "candidates": "chunk_embeddings",
        "candidate_texts": "doc_chunks"
      },
      "outputs": {
        "ranked": "coarse_contexts"
      }
    },
    {
      "id": "node_4_TextRerankNode",
      "node_type": "TextRerankNode",
      "config": {
        "bind_model": "rerank_model_v1",
        "top_k": 1
      },
      "inputs": {
        "queries": "raw_queries",
        "candidates": "coarse_contexts"
      },
      "outputs": {
        "ranked": "fine_contexts"
      }
    },
    {
      "id": "node_5_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "【经过精排选取的精准参考上下文】: {{context}}\n【用户提问】: {{primary}}\n请根据上述上下文给出专业、严谨且精炼的解答:"
      },
      "inputs": {
        "primary": "raw_queries",
        "context": "fine_contexts"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_6_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "config": {
        "default_category": "GENERAL_QA",
        "default_score": 0.9,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp",
            "Rerank"
          ]
        }
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "matches": "intent_matches"
      }
    },
    {
      "id": "node_7_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "llm_model_v1",
        "max_tokens": 128,
        "temperature": 0.3
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_answers"
      }
    }
  ]
}
