{
  "io": {
    "input": [
      {
        "type": "rerank_in",
        "name": "cross_rerank"
      }
    ],
    "output": [
      {
        "type": "rerank_out",
        "name": "cross_rerank",
        "inputs": {
          "ranked": "rank_candidates.ranked"
        }
      }
    ]
  },
  "models": [
    {
      "type": "rerank",
      "name": "rerank_model",
      "file": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "params": {
        "tokenizer_file": "ms_marco_bert_vocab.txt"
      },
      "backend": {
        "type": "onnxruntime"
      }
    }
  ],
  "pipeline": [
    {
      "type": "text_rerank",
      "name": "rank_candidates",
      "params": {
        "bind_model": "rerank_model",
        "top_k": 8
      },
      "inputs": {
        "queries": "input.query_text",
        "candidates": "input.candidates"
      }
    }
  ]
}
