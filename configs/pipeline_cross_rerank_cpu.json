{
  "biz_name": "dense_cross_rerank_scoring",
  "models": [
    {
      "model_id": "rerank_model_v1",
      "capability": "rerank",
      "model_type": "bge_reranker",
      "backend": "onnxruntime",
      "model_path": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "model_config": {
        "tokenizer_file": "ms_marco_bert_vocab.txt",
        "do_lower_case": true,
        "max_length": 512,
        "output_name": "logits",
        "score_activation": "sigmoid",
        "max_batch_size": 4
