{
  "io": {
    "input": [
      {
        "type": "rerank_in",
        "name": "cross_rerank"
      }
    ],
    "output": [
      {
        "type": "rerank_out",
        "name": "cross_rerank"
      }
    ]
  },
  "models": [
    {
      "type": "rerank",
      "name": "rerank_model",
      "file": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "params": {
        "tokenizer_file": "ms_marco_bert_vocab.txt"
      },
      "backend": {
        "type": "onnxruntime"
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextRerankNode",
      "node_type": "TextRerankNode",
      "config": {
        "bind_model": "rerank_model",
        "top_k": 8
      },
      "inputs": {
        "queries": "rerank_queries",
        "candidates": "rerank_candidates"
      },
      "outputs": {
        "ranked": "ranked_results"
      }
    }
  ]
}
