{
  "biz_name": "multimodal_ocr_invoice_qa",
  "models": [
    {
      "capability": "ocr",
      "model_type": "vision_document",
      "backend": "kite_llm",
      "model_config": {
        "patch_size": 16,
        "max_tokens": 256
      },
      "backend_config": {
        "run_config_file": "kite_vision_run.json"
      },
      "model_id": "ocr_model_v1",
      "model_path": "SmolVLM-256M-Instruct-Q8_0.gguf"
    },
    {
      "capability": "llm",
      "model_type": "qwen_causal_lm",
      "backend": "kite_llm",
      "model_config": {
        "random_seed": -1
      },
      "backend_config": {
        "run_config_file": "kite_text_run.json"
      },
      "model_id": "llm_model_v1",
      "model_path": "qwen2.5-0.5b-instruct-q4_k_m.gguf"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_OcrDetectNode",
      "node_type": "OcrDetectNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "images": "image_paths"
        },
        "outputs": {
          "document": "ocr_docs",
          "text": "ocr_text"
        }
      },
      "config": {
        "bind_model": "ocr_model_v1"
      }
    },
    {
      "id": "node_1_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "depends_on": [
        "node_0_OcrDetectNode"
      ],
      "ports": {
        "inputs": {
          "primary": "user_queries",
          "document": "ocr_docs"
        },
        "outputs": {
          "text": "prompt_text"
        }
      },
      "config": {
        "template": "请根据以下OCR识别出的发票单据内容，回答用户的问题并以JSON输出：\n【单据内容】：\n{{document}}\n【用户问题】：{{primary}}\n【提取结果】：",
        "separator": "\n"
      }
    },
    {
      "id": "node_2_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "depends_on": [
        "node_1_TextTemplateNode"
      ],
      "ports": {
        "inputs": {
          "prompt": "prompt_text"
        },
        "outputs": {
          "text": "llm_raw_answer"
        }
      },
      "config": {
        "bind_model": "llm_model_v1",
        "max_tokens": 256,
        "temperature": 0.0
      }
    },
    {
      "id": "node_3_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "depends_on": [
        "node_2_LlmGenerateNode"
      ],
      "ports": {
        "inputs": {
          "text": "llm_raw_answer"
        },
        "outputs": {
          "document": "extracted_invoice_json"
        }
      },
      "config": {
        "failure_policy": "fail"
      }
    }
  ]
}
