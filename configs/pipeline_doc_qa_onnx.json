{
  "biz_name": "smart_doc_qa_onnx_llamacpp_v1",
  "models": [
    {
      "config": {
        "embedding_dim": 128,
        "max_batch_size": 4
      },
      "engine_type": "onnx_embedding",
      "model_id": "embed_model_onnx",
      "model_path": "./models/bge_base_zh_v1.5.onnx"
    },
    {
      "config": {
        "max_batch_size": 2,
        "max_seq_len": 1024
      },
      "engine_type": "llama_cpp",
      "model_id": "llm_model_llamacpp",
      "model_path": "./models/qwen2.5_1.5b_instruct_q4_k_m.gguf"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_docs"
        },
        "outputs": {
          "chunks": "doc_chunks"
        }
      },
      "config": {
        "chunk_size": 60
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "embedding": "query_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_onnx"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [
        "node_0_TextChunkNode"
      ],
      "ports": {
        "inputs": {
          "text": "doc_chunks"
        },
        "outputs": {
          "embedding": "chunk_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_onnx"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "depends_on": [
        "node_1_QueryEmbeddingNode",
        "node_2_ChunkEmbeddingNode"
      ],
      "ports": {
        "inputs": {
          "queries": "query_embeddings",
          "candidates": "chunk_embeddings",
          "candidate_texts": "doc_chunks"
        },
        "outputs": {
          "ranked": "ranked_contexts"
        }
      },
      "config": {
        "min_score": 0.0,
        "top_k": 1
      }
    },
    {
      "id": "node_4_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "depends_on": [
        "node_3_VectorTopKNode"
      ],
      "ports": {
        "inputs": {
          "primary": "raw_queries",
          "context": "ranked_contexts"
        },
        "outputs": {
          "text": "prompt_text"
        }
      },
      "config": {
        "template": "【参考片段】: {{context}}\n【用户提问】: {{primary}}\n请基于参考片段给出精确解答:"
      }
    },
    {
      "id": "node_5_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "matches": "intent_matches"
        }
      },
      "config": {
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp"
          ]
        }
      }
    },
    {
      "id": "node_6_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "depends_on": [
        "node_4_TextTemplateNode"
      ],
      "ports": {
        "inputs": {
          "prompt": "prompt_text"
        },
        "outputs": {
          "text": "llm_answers"
        }
      },
      "config": {
        "bind_model": "llm_model_llamacpp",
        "max_tokens": 128,
        "temperature": 0.3
      }
    }
  ]
}
