{
  "biz_name": "smart_doc_qa_onnx_llamacpp_v1",
  "models": [
    {
      "model_id": "embed_model_onnx",
      "capability": "embedding",
      "model_type": "bge_embedding",
      "backend": "onnxruntime",
      "model_path": "./models/bge_base_zh_v1.5.onnx",
      "model_config": {
        "tokenizer_file": "vocab.txt",
        "do_lower_case": true,
        "max_length": 512,
        "pooling_strategy": "cls",
        "normalize": true,
        "output_name": "last_hidden_state",
        "embedding_dim": 128
      },
      "backend_config": {
        "max_batch_size": 4,
        "intra_op_num_threads": 2,
        "inter_op_num_threads": 1,
        "graph_optimization_level": "all"
      }
    },
    {
      "model_id": "llm_model_llamacpp",
      "capability": "llm",
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_path": "./models/qwen2.5_1.5b_instruct_q4_k_m.gguf",
      "model_config": {
        "chat_template": "qwen_chatml",
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 1024,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_docs"
        },
        "outputs": {
          "chunks": "doc_chunks",
          "chunk_counts": "doc_chunk_counts"
        }
      },
      "config": {
        "chunk_size": 60
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "embedding": "query_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_onnx"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [
        "node_0_TextChunkNode"
      ],
      "ports": {
        "inputs": {
          "text": "doc_chunks"
        },
        "outputs": {
          "embedding": "chunk_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_onnx"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "depends_on": [
        "node_1_QueryEmbeddingNode",
        "node_2_ChunkEmbeddingNode"
      ],
      "ports": {
        "inputs": {
          "queries": "query_embeddings",
          "candidates": "chunk_embeddings",
          "candidate_texts": "doc_chunks"
        },
        "outputs": {
          "ranked": "ranked_contexts"
        }
      },
      "config": {
        "min_score": 0.0,
        "top_k": 1
      }
    },
    {
      "id": "node_4_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "depends_on": [
        "node_3_VectorTopKNode"
      ],
      "ports": {
        "inputs": {
          "primary": "raw_queries",
          "context": "ranked_contexts"
        },
        "outputs": {
          "text": "prompt_text"
        }
      },
      "config": {
        "template": "【参考片段】: {{context}}\n【用户提问】: {{primary}}\n请基于参考片段给出精确解答:"
      }
    },
    {
      "id": "node_5_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "matches": "intent_matches"
        }
      },
      "config": {
        "default_category": "GENERAL_QA",
        "default_score": 0.90,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp"
          ]
        }
      }
    },
    {
      "id": "node_6_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "depends_on": [
        "node_4_TextTemplateNode"
      ],
      "ports": {
        "inputs": {
          "prompt": "prompt_text"
        },
        "outputs": {
          "text": "llm_answers"
        }
      },
      "config": {
        "bind_model": "llm_model_llamacpp",
        "max_tokens": 128,
        "temperature": 0.3
      }
    }
  ]
}
