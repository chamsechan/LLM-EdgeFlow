{
  "io": {
    "input": [
      {
        "type": "frame",
        "name": "ocr_invoice_qa"
      },
      {
        "type": "string",
        "name": "ocr_invoice_qa"
      }
    ],
    "output": [
      {
        "type": "od_out",
        "name": "ocr_invoice_qa"
      }
    ]
  },
  "models": [
    {
      "type": "ocr",
      "name": "ocr_model",
      "file": "SmolVLM-256M-Instruct-Q8_0.gguf",
      "params": {
        "max_tokens": 256
      },
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_vision_run.json"
        }
      }
    },
    {
      "type": "llm",
      "name": "llm_model",
      "file": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_text_run.json"
        }
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_OcrDetectNode",
      "node_type": "OcrDetectNode",
      "config": {
        "bind_model": "ocr_model"
      },
      "inputs": {
        "images": "image_paths"
      },
      "outputs": {
        "document": "ocr_docs",
        "text": "ocr_text"
      }
    },
    {
      "id": "node_1_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "请根据以下OCR识别出的发票单据内容，回答用户的问题并以JSON输出：\n【单据内容】：\n{{document}}\n【用户问题】：{{primary}}\n【提取结果】：",
        "separator": "\n"
      },
      "inputs": {
        "primary": "user_queries",
        "document": "ocr_docs"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_2_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "llm_model",
        "max_tokens": 256,
        "temperature": 0.0
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_raw_answer"
      }
    },
    {
      "id": "node_3_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "config": {
        "failure_policy": "fail"
      },
      "inputs": {
        "text": "llm_raw_answer"
      },
      "outputs": {
        "document": "extracted_invoice_json"
      }
    }
  ]
}
