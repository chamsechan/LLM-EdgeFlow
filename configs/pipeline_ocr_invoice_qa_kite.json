{
  "io": {
    "input": [
      {
        "type": "frame",
        "name": "ocr_invoice_qa"
      },
      {
        "type": "string",
        "name": "ocr_invoice_qa"
      }
    ],
    "output": [
      {
        "type": "od_out",
        "name": "ocr_invoice_qa",
        "inputs": {
          "result": "parse_invoice.document",
          "document": "read_invoice.document"
        }
      }
    ]
  },
  "models": [
    {
      "type": "ocr",
      "name": "ocr_model",
      "file": "SmolVLM-256M-Instruct-Q8_0.gguf",
      "params": {
        "max_tokens": 256
      },
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_vision_run.json"
        }
      }
    },
    {
      "type": "llm",
      "name": "llm_model",
      "file": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_text_run.json"
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "ocr_detect",
      "name": "read_invoice",
      "params": {
        "bind_model": "ocr_model"
      },
      "inputs": {
        "images": "input.image"
      }
    },
    {
      "type": "text_template",
      "name": "build_prompt",
      "params": {
        "template": "请根据以下OCR识别出的发票单据内容，回答用户的问题并以JSON输出：\n【单据内容】：\n{{document}}\n【用户问题】：{{primary}}\n【提取结果】："
      },
      "inputs": {
        "primary": "input.question",
        "document": "read_invoice.document"
      }
    },
    {
      "type": "llm_generate",
      "name": "generate_invoice",
      "params": {
        "bind_model": "llm_model",
        "max_tokens": 256,
        "temperature": 0.0,
        "endpoints": {
          "invoice": {}
        }
      },
      "inputs": {
        "input": "build_prompt.text"
      }
    },
    {
      "type": "structured_json_parse",
      "name": "parse_invoice",
      "params": {
        "failure_policy": "fail"
      },
      "inputs": {
        "text": "generate_invoice.text"
      }
    }
  ]
}
