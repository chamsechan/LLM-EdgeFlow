{
  "io": {
    "input": [
      {
        "type": "audit_in",
        "name": "dialogue_audit"
      }
    ],
    "output": [
      {
        "type": "audit_out",
        "name": "dialogue_audit",
        "inputs": {
          "verdict": "parse_verdict.document",
          "matched_policy": "rerank_policies.ranked"
        }
      }
    ]
  },
  "models": [
    {
      "type": "embedding",
      "name": "embed_model",
      "file": "bge_base_zh_v1.5.onnx",
      "params": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "embedding_dim": 768
      },
      "backend": {
        "type": "onnxruntime"
      }
    },
    {
      "type": "rerank",
      "name": "rerank_model",
      "file": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "params": {
        "tokenizer_file": "ms_marco_bert_vocab.txt"
      },
      "backend": {
        "type": "onnxruntime"
      }
    },
    {
      "type": "llm",
      "name": "audit_llm",
      "file": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_text_run.json"
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "text_rule_match",
      "name": "match_rules",
      "params": {
        "categories": {
          "BLACKLIST": [
            "私下转账",
            "加微信",
            "索取密码",
            "发送验证码",
            "刷单返利"
          ]
        }
      },
      "inputs": {
        "text": "input.user_text"
      }
    },
    {
      "type": "text_corpus_source",
      "name": "policy_corpus",
      "params": {
        "corpus": [
          "制度条款101: 严禁引导客户进行私下转账、绕过平台交易或索取银行卡密码",
          "制度条款102: 客服人员不得向客户索取手机动态短信验证码及支付密码",
          "制度条款103: 严禁以任何理由向客户推介非官方指定的返利或刷单活动",
          "制度条款104: 规范客服日常服务用语，严禁出现侮辱、辱骂或威胁客户的行为"
        ]
      }
    },
    {
      "type": "text_embedding",
      "name": "embed_dialogue",
      "params": {
        "bind_model": "embed_model"
      },
      "inputs": {
        "text": "input.user_text"
      }
    },
    {
      "type": "text_embedding",
      "name": "embed_policies",
      "params": {
        "bind_model": "embed_model"
      },
      "inputs": {
        "text": "policy_corpus.corpus"
      }
    },
    {
      "type": "vector_top_k",
      "name": "retrieve_policies",
      "params": {
        "top_k": 3
      },
      "inputs": {
        "queries": "embed_dialogue.embedding",
        "candidates": "embed_policies.embedding",
        "candidate_texts": "policy_corpus.corpus"
      }
    },
    {
      "type": "text_rerank",
      "name": "rerank_policies",
      "params": {
        "bind_model": "rerank_model"
      },
      "inputs": {
        "queries": "input.user_text",
        "candidates": "retrieve_policies.ranked"
      }
    },
    {
      "type": "text_template",
      "name": "build_prompt",
      "params": {
        "template": "判断下面客服对话是否存在违规行为。\n对话：{{primary}}\n制度参考：{{context}}\n规则匹配：{{matches}}\n只输出JSON，必须包含risk_level和risk_score两个字段。违规时risk_level为HIGH_RISK，合规时为SAFE；risk_score为0到1的数字。\n输出格式示例：{\"risk_level\":\"SAFE\",\"risk_score\":0.0}"
      },
      "inputs": {
        "primary": "input.user_text",
        "context": "rerank_policies.ranked",
        "matches": "match_rules.matches"
      }
    },
    {
      "type": "llm_generate",
      "name": "generate_verdict",
      "params": {
        "bind_model": "audit_llm",
        "temperature": 0.0,
        "system_prompt": "You are a compliance classifier. Return only a valid JSON object. Never output explanations or Markdown.",
        "endpoints": {
          "verdict": {}
        }
      },
      "inputs": {
        "input": "build_prompt.text"
      }
    },
    {
      "type": "structured_json_parse",
      "name": "parse_verdict",
      "params": {
        "field_types": {
          "risk_level": "string",
          "risk_score": "number"
        },
        "required_fields": [
          "risk_level",
          "risk_score"
        ],
        "failure_policy": "fail"
      },
      "inputs": {
        "text": "generate_verdict.text"
      }
    }
  ]
}
