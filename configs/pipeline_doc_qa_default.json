{
  "deployment": {
    "io": {
      "io_binding": "doc_qa.operator.v1"
    }
  },
  "models": [
    {
      "model_type": "bge_embedding",
      "backend": "onnxruntime",
      "model_config": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "embedding_dim": 768
      },
      "backend_config": {
        "max_batch_size": 4
      },
      "model_id": "embed_model_v1",
      "model_path": "./models/bge_base_zh_v1.5.onnx"
    },
    {
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_config": {
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 1024,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      },
      "model_id": "llm_model_v1",
      "model_path": "./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "config": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "raw_docs"
      },
      "outputs": {
        "chunks": "doc_chunks",
        "chunk_counts": "doc_chunk_counts"
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_v1"
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "embedding": "query_embeddings"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_v1"
      },
      "inputs": {
        "text": "doc_chunks"
      },
      "outputs": {
        "embedding": "chunk_embeddings"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "config": {
        "min_score": 0.0,
        "top_k": 1
      },
      "inputs": {
        "queries": "query_embeddings",
        "candidates": "chunk_embeddings",
        "candidate_texts": "doc_chunks"
      },
      "outputs": {
        "ranked": "ranked_contexts"
      }
    },
    {
      "id": "node_4_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "【参考片段】: {{context}}\n【用户提问】: {{primary}}\n请基于参考片段给出精确解答:"
      },
      "inputs": {
        "primary": "raw_queries",
        "context": "ranked_contexts"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_5_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "config": {
        "default_category": "GENERAL_QA",
        "default_score": 0.9,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货",
            "发票"
          ],
          "LOGISTICS_STATUS": [
            "快递",
            "发货",
            "物流",
            "送到哪里"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "NPU"
          ]
        }
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "matches": "intent_matches"
      }
    },
    {
      "id": "node_6_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "llm_model_v1",
        "max_tokens": 128,
        "temperature": 0.3
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_answers"
      }
    }
  ]
}
