{
  "biz_name": "smart_doc_qa_v1",
  "deployment": {
    "model_paths": {
      "embed_model_onnx": "./models/bge_base_zh_v1.5.onnx",
      "llm_model_llamacpp": "./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    },
    "io": {
      "io_binding": "doc_qa.operator.v1",
      "output_allocations": {
        "doc_out": {
          "type": "doc_out",
          "meta_num": 0,
          "metadata_type_id": 0,
          "capacities": {
            "intent_name": 63,
            "answer_text": 1023
          }
        }
      }
    }
  },
  "models": [
    {
      "model_id": "embed_model_onnx",
      "model_type": "bge_embedding",
      "backend": "onnxruntime",
      "model_path": "bge_base_zh_v1.5.onnx",
      "model_config": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "do_lower_case": true,
        "max_length": 512,
        "pooling_strategy": "cls",
        "output_name": "last_hidden_state",
        "embedding_dim": 768
      },
      "backend_config": {
        "max_batch_size": 4,
        "intra_op_num_threads": 2,
        "inter_op_num_threads": 1,
        "graph_optimization_level": "all"
      }
    },
    {
      "model_id": "llm_model_llamacpp",
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_path": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "model_config": {
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 1024,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "config": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "raw_docs"
      },
      "outputs": {
        "chunks": "doc_chunks",
        "chunk_counts": "doc_chunk_counts"
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_onnx"
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "embedding": "query_embeddings"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_onnx"
      },
      "inputs": {
        "text": "doc_chunks"
      },
      "outputs": {
        "embedding": "chunk_embeddings"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "config": {
        "min_score": 0.0,
        "top_k": 1
      },
      "inputs": {
        "queries": "query_embeddings",
        "candidates": "chunk_embeddings",
        "candidate_texts": "doc_chunks"
      },
      "outputs": {
        "ranked": "ranked_contexts"
      }
    },
    {
      "id": "node_4_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "【参考片段】: {{context}}\n【用户提问】: {{primary}}\n请基于参考片段给出精确解答:"
      },
      "inputs": {
        "primary": "raw_queries",
        "context": "ranked_contexts"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_5_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "config": {
        "default_category": "GENERAL_QA",
        "default_score": 0.9,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp"
          ]
        }
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "matches": "intent_matches"
      }
    },
    {
      "id": "node_6_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "llm_model_llamacpp",
        "max_tokens": 128,
        "temperature": 0.3
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_answers"
      }
    }
  ]
}
