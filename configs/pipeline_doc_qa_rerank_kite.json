{
  "io": {
    "input": [
      {
        "type": "doc_in",
        "name": "doc_qa"
      }
    ],
    "output": [
      {
        "type": "doc_out",
        "name": "doc_qa",
        "inputs": {
          "answer_text": "generate_answer.text",
          "intent": "match_intent.matches",
          "chunk_count": "chunk_docs.chunk_counts"
        }
      }
    ]
  },
  "models": [
    {
      "type": "embedding",
      "name": "embed_model",
      "file": "bge_base_zh_v1.5.onnx",
      "params": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "embedding_dim": 768
      },
      "backend": {
        "type": "onnxruntime"
      }
    },
    {
      "type": "rerank",
      "name": "rerank_model",
      "file": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "params": {
        "tokenizer_file": "ms_marco_bert_vocab.txt"
      },
      "backend": {
        "type": "onnxruntime"
      }
    },
    {
      "type": "llm",
      "name": "llm_model",
      "file": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "backend": {
        "type": "kite_llm",
        "params": {
          "run_config_file": "kite_text_run.json"
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "text_chunk",
      "name": "chunk_docs",
      "params": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "input.doc_text"
      }
    },
    {
      "type": "text_embedding",
      "name": "embed_query",
      "params": {
        "bind_model": "embed_model"
      },
      "inputs": {
        "text": "input.query_text"
      }
    },
    {
      "type": "text_embedding",
      "name": "embed_chunks",
      "params": {
        "bind_model": "embed_model"
      },
      "inputs": {
        "text": "chunk_docs.chunks"
      }
    },
    {
      "type": "vector_top_k",
      "name": "retrieve",
      "params": {
        "top_k": 4
      },
      "inputs": {
        "queries": "embed_query.embedding",
        "candidates": "embed_chunks.embedding",
        "candidate_texts": "chunk_docs.chunks"
      }
    },
    {
      "type": "text_rerank",
      "name": "rerank_contexts",
      "params": {
        "bind_model": "rerank_model"
      },
      "inputs": {
        "queries": "input.query_text",
        "candidates": "retrieve.ranked"
      }
    },
    {
      "type": "text_template",
      "name": "build_prompt",
      "params": {
        "template": "【精准检索上下文】: {{context}}\n【用户提问】: {{primary}}\n请给出解答:"
      },
      "inputs": {
        "primary": "input.query_text",
        "context": "rerank_contexts.ranked"
      }
    },
    {
      "type": "text_rule_match",
      "name": "match_intent",
      "params": {
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp",
            "Rerank"
          ]
        }
      },
      "inputs": {
        "text": "input.query_text"
      }
    },
    {
      "type": "llm_generate",
      "name": "generate_answer",
      "params": {
        "bind_model": "llm_model",
        "temperature": 0.0,
        "endpoints": {
          "answer": {}
        }
      },
      "inputs": {
        "input": "build_prompt.text"
      }
    }
  ]
}
