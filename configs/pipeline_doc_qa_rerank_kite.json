{
  "biz_name": "smart_doc_qa_v1",
  "deployment": {
    "model_paths": {
      "embed_model_onnx": "models/bge_base_zh_v1.5.onnx",
      "rerank_model_onnx": "models/ms_marco_tinybert_l2_v2_quantized.onnx",
      "llm_model_llamacpp": "models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    },
    "io": {
      "io_binding": "doc_qa.operator.v1",
      "output_allocations": {
        "doc_out": {
          "type": "doc_out",
          "meta_num": 0,
          "metadata_type_id": 0,
          "capacities": {
            "intent_name": 63,
            "answer_text": 1023
          }
        }
      }
    }
  },
  "models": [
    {
      "model_id": "embed_model_onnx",
      "model_type": "bge_embedding",
      "backend": "onnxruntime",
      "model_path": "bge_base_zh_v1.5.onnx",
      "model_config": {
        "tokenizer_file": "bge_base_zh_v1.5_vocab.txt",
        "do_lower_case": true,
        "max_length": 512,
        "pooling_strategy": "cls",
        "output_name": "last_hidden_state",
        "embedding_dim": 768
      },
      "backend_config": {
        "max_batch_size": 4,
        "intra_op_num_threads": 2,
        "inter_op_num_threads": 1,
        "graph_optimization_level": "all"
      }
    },
    {
      "model_id": "rerank_model_onnx",
      "model_type": "bge_reranker",
      "backend": "onnxruntime",
      "model_path": "ms_marco_tinybert_l2_v2_quantized.onnx",
      "model_config": {
        "tokenizer_file": "ms_marco_bert_vocab.txt",
        "do_lower_case": true,
        "max_length": 512,
        "output_name": "logits",
        "score_activation": "sigmoid",
        "max_batch_size": 4
      },
      "backend_config": {
        "max_batch_size": 4,
        "intra_op_num_threads": 2,
        "inter_op_num_threads": 1,
        "graph_optimization_level": "all"
      }
    },
    {
      "model_id": "llm_model_llamacpp",
      "model_type": "qwen_causal_lm",
      "backend": "kite_llm",
      "model_path": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "model_config": {
        "random_seed": -1
      },
      "backend_config": {
        "run_config_file": "kite_text_run.json"
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "config": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "raw_docs"
      },
      "outputs": {
        "chunks": "doc_chunks",
        "chunk_counts": "doc_chunk_counts"
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_onnx"
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "embedding": "query_embeddings"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "config": {
        "bind_model": "embed_model_onnx"
      },
      "inputs": {
        "text": "doc_chunks"
      },
      "outputs": {
        "embedding": "chunk_embeddings"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "config": {
        "min_score": 0.0,
        "top_k": 4
      },
      "inputs": {
        "queries": "query_embeddings",
        "candidates": "chunk_embeddings",
        "candidate_texts": "doc_chunks"
      },
      "outputs": {
        "ranked": "coarse_contexts"
      }
    },
    {
      "id": "node_4_TextRerankNode",
      "node_type": "TextRerankNode",
      "config": {
        "bind_model": "rerank_model_onnx",
        "top_k": 1
      },
      "inputs": {
        "queries": "raw_queries",
        "candidates": "coarse_contexts"
      },
      "outputs": {
        "ranked": "fine_contexts"
      }
    },
    {
      "id": "node_5_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "【精准检索上下文】: {{context}}\n【用户提问】: {{primary}}\n请给出解答:"
      },
      "inputs": {
        "primary": "raw_queries",
        "context": "fine_contexts"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_6_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "config": {
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "ONNX",
            "llama.cpp",
            "Rerank"
          ]
        }
      },
      "inputs": {
        "text": "raw_queries"
      },
      "outputs": {
        "matches": "intent_matches"
      }
    },
    {
      "id": "node_7_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "llm_model_llamacpp",
        "max_tokens": 128,
        "temperature": 0.0
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_answers"
      }
    }
  ]
}
