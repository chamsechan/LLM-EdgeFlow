{
  "biz_name": "speech_audio_asr_intent_slot",
  "models": [
    {
      "config": {
        "max_batch_size": 2
      },
      "engine_type": "mock_npu_asr",
      "model_id": "asr_model_v1",
      "model_path": "./models/paraformer_asr_npu.bin"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_AsrTranscribeNode",
      "node_type": "AsrTranscribeNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "audio": "audio_inputs"
        },
        "outputs": {
          "text": "transcripts"
        }
      },
      "config": {
        "bind_model": "asr_model_v1"
      }
    },
    {
      "id": "node_1_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "depends_on": [
        "node_0_AsrTranscribeNode"
      ],
      "ports": {
        "inputs": {
          "text": "transcripts"
        },
        "outputs": {
          "matches": "intent_slots"
        }
      },
      "config": {
        "categories": {
          "MUSIC_PLAY": [
            "播放",
            "音乐",
            "我想听"
          ],
          "NAVIGATION": [
            "导航",
            "路线",
            "去哪"
          ],
          "VEHICLE_HVAC_CONTROL": [
            "空调",
            "温度",
            "风量",
            "二档"
          ]
        }
      }
    }
  ]
}
