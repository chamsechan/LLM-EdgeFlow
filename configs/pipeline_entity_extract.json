{
  "biz_name": "entity_extract_0.6b_v1",
  "models": [
    {
      "capability": "llm",
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_config": {
        "chat_template": "qwen_chatml",
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 512,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      },
      "model_id": "llm_0.6b_entity",
      "model_path": "./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "primary": "input_sentences"
        },
        "outputs": {
          "text": "prompt_text"
        }
      },
      "config": {
        "template": "你是一个中文实体与名词抽取助手。请从以下句子中提取出所有名词与实体，并仅以JSON列表形式返回：\n输入文本：{{primary}}\n提取结果："
      }
    },
    {
      "id": "node_1_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "depends_on": [
        "node_0_TextTemplateNode"
      ],
      "ports": {
        "inputs": {
          "prompt": "prompt_text"
        },
        "outputs": {
          "text": "llm_raw_answer"
        }
      },
      "config": {
        "bind_model": "llm_0.6b_entity",
        "max_tokens": 64,
        "temperature": 0.1
      }
    },
    {
      "id": "node_2_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "depends_on": [
        "node_1_LlmGenerateNode"
      ],
      "ports": {
        "inputs": {
          "text": "llm_raw_answer"
        },
        "outputs": {
          "document": "extracted_entities"
        }
      },
      "config": {
        "fallback_json": "[]"
      }
    }
  ]
}
