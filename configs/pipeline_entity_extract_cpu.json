{
  "deployment": {
    "model_paths": {
      "entity_llm": "./models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
    },
    "io": {
      "io_binding": "entity_extract.operator.v1"
    }
  },
  "models": [
    {
      "model_id": "entity_llm",
      "model_type": "qwen_causal_lm",
      "backend": "llama_cpp",
      "model_path": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
      "model_config": {
        "system_prompt": "",
        "add_bos": false,
        "random_seed": -1
      },
      "backend_config": {
        "context_size": 512,
        "decode_batch_size": 512,
        "n_threads": 0,
        "n_threads_batch": 0,
        "n_gpu_layers": 0,
        "check_tensors": false
      }
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "你是一个中文实体与名词抽取助手。请从以下句子中提取出所有名词与实体，并仅以JSON列表形式返回：\n输入文本：{{primary}}\n提取结果："
      },
      "inputs": {
        "primary": "input_sentences"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_1_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "entity_llm",
        "max_tokens": 256,
        "temperature": 0.0
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_raw_answer"
      }
    },
    {
      "id": "node_2_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "config": {
        "failure_policy": "fail"
      },
      "inputs": {
        "text": "llm_raw_answer"
      },
      "outputs": {
        "document": "extracted_entities"
      }
    }
  ]
}
