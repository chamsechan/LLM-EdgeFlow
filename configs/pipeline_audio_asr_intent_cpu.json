{
  "io": {
    "input": [
      {
        "type": "audio_in",
        "name": "audio_asr_intent"
      }
    ],
    "output": [
      {
        "type": "audio_out",
        "name": "audio_asr_intent"
      }
    ]
  },
  "models": [
    {
      "type": "asr",
      "name": "asr_model",
      "file": "ggml-base.bin",
      "backend": {
        "type": "whisper_cpp"
      }
    }
  ],
  "pipeline": [
    {
      "id": "transcribe",
      "node_type": "AsrTranscribeNode",
      "config": {
        "bind_model": "asr_model"
      },
      "inputs": {
        "audio": "audio_inputs"
      },
      "outputs": {
        "text": "transcripts"
      }
    },
    {
      "id": "intent",
      "node_type": "TextRuleMatchNode",
      "config": {
        "default_category": "UNCLASSIFIED",
        "categories": {
          "NAVIGATION": [
            "导航",
            "導航"
          ],
          "MUSIC_PLAY": [
            "播放"
          ]
        }
      },
      "inputs": {
        "text": "transcripts"
      },
      "outputs": {
        "matches": "intent_slots"
      }
    }
  ]
}
