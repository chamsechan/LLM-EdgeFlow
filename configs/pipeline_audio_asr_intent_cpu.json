{
  "io": {
    "input": [
      {
        "type": "audio_in",
        "name": "audio_asr_intent"
      }
    ],
    "output": [
      {
        "type": "audio_out",
        "name": "audio_asr_intent",
        "inputs": {
          "transcribed_text": "transcribe_audio.text",
          "intent_slot": "match_intent.matches"
        }
      }
    ]
  },
  "models": [
    {
      "type": "asr",
      "name": "asr_model",
      "file": "ggml-base.bin",
      "backend": {
        "type": "whisper_cpp"
      }
    }
  ],
  "pipeline": [
    {
      "type": "asr_transcribe",
      "name": "transcribe_audio",
      "params": {
        "bind_model": "asr_model"
      },
      "inputs": {
        "audio": "input.audio"
      }
    },
    {
      "type": "text_rule_match",
      "name": "match_intent",
      "params": {
        "default_category": "UNCLASSIFIED",
        "categories": {
          "NAVIGATION": [
            "导航",
            "導航"
          ],
          "MUSIC_PLAY": [
            "播放"
          ]
        }
      },
      "inputs": {
        "text": "transcribe_audio.text"
      }
    }
  ]
}
