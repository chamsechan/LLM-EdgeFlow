{
  "deployment": {
    "model_paths": {
      "asr_model_v1": "models/ggml-base.bin"
    },
    "io": {
      "io_binding": "audio_asr_intent.operator.v1"
    }
  },
  "models": [
    {
      "model_id": "asr_model_v1",
      "model_type": "whisper_asr",
      "backend": "whisper_cpp",
      "model_path": "ggml-base.bin",
      "model_config": {
        "language": "zh",
        "max_audio_seconds": 30,
        "max_output_bytes": 65536
      },
      "backend_config": {
        "n_threads": 4
      }
    }
  ],
  "pipeline": [
    {
      "id": "transcribe",
      "node_type": "AsrTranscribeNode",
      "config": {
        "bind_model": "asr_model_v1"
      },
      "inputs": {
        "audio": "audio_inputs"
      },
      "outputs": {
        "text": "transcripts"
      }
    },
    {
      "id": "intent",
      "node_type": "TextRuleMatchNode",
      "config": {
        "default_category": "UNCLASSIFIED",
        "categories": {
          "NAVIGATION": [
            "导航",
            "導航"
          ],
          "MUSIC_PLAY": [
            "播放"
          ]
        }
      },
      "inputs": {
        "text": "transcripts"
      },
      "outputs": {
        "matches": "intent_slots"
      }
    }
  ]
}
