{
  "biz_name": "smart_doc_qa_v1",
  "models": [
    {
      "capability": "embedding",
      "model_type": "test_business_embedding",
      "backend": "test_tensor_backend",
      "model_config": {
        "embedding_dim": 128,
        "max_batch_size": 4
      },
      "backend_config": {},
      "model_id": "embed_model_v1",
      "model_path": "demo/fixtures/mock/artifacts/neutral-embedding.fixture"
    },
    {
      "capability": "llm",
      "model_type": "test_business_llm",
      "backend": "test_causal_lm_backend",
      "model_config": {
        "max_batch_size": 2,
        "max_seq_len": 1024
      },
      "backend_config": {},
      "model_id": "llm_model_v1",
      "model_path": "demo/fixtures/mock/artifacts/neutral-llm.fixture"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextChunkNode",
      "node_type": "TextChunkNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_docs"
        },
        "outputs": {
          "chunks": "doc_chunks",
          "chunk_counts": "doc_chunk_counts"
        }
      },
      "config": {
        "chunk_size": 60
      }
    },
    {
      "id": "node_1_QueryEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "embedding": "query_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_v1"
      }
    },
    {
      "id": "node_2_ChunkEmbeddingNode",
      "node_type": "TextEmbeddingNode",
      "depends_on": [
        "node_0_TextChunkNode"
      ],
      "ports": {
        "inputs": {
          "text": "doc_chunks"
        },
        "outputs": {
          "embedding": "chunk_embeddings"
        }
      },
      "config": {
        "bind_model": "embed_model_v1"
      }
    },
    {
      "id": "node_3_VectorTopKNode",
      "node_type": "VectorTopKNode",
      "depends_on": [
        "node_1_QueryEmbeddingNode",
        "node_2_ChunkEmbeddingNode"
      ],
      "ports": {
        "inputs": {
          "queries": "query_embeddings",
          "candidates": "chunk_embeddings",
          "candidate_texts": "doc_chunks"
        },
        "outputs": {
          "ranked": "ranked_contexts"
        }
      },
      "config": {
        "min_score": 0.0,
        "top_k": 1
      }
    },
    {
      "id": "node_4_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "depends_on": [
        "node_3_VectorTopKNode"
      ],
      "ports": {
        "inputs": {
          "primary": "raw_queries",
          "context": "ranked_contexts"
        },
        "outputs": {
          "text": "prompt_text"
        }
      },
      "config": {
        "template": "【参考片段】: {{context}}\n【用户提问】: {{primary}}\n请基于参考片段给出精确解答:"
      }
    },
    {
      "id": "node_5_TextRuleMatchNode",
      "node_type": "TextRuleMatchNode",
      "depends_on": [],
      "ports": {
        "inputs": {
          "text": "raw_queries"
        },
        "outputs": {
          "matches": "intent_matches"
        }
      },
      "config": {
        "default_category": "GENERAL_QA",
        "default_score": 0.90,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货",
            "发票"
          ],
          "LOGISTICS_STATUS": [
            "快递",
            "发货",
            "物流",
            "送到哪里"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "NPU"
          ]
        }
      }
    },
    {
      "id": "node_6_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "depends_on": [
        "node_4_TextTemplateNode"
      ],
      "ports": {
        "inputs": {
          "prompt": "prompt_text"
        },
        "outputs": {
          "text": "llm_answers"
        }
      },
      "config": {
        "bind_model": "llm_model_v1",
        "max_tokens": 128,
        "temperature": 0.3
      }
    }
  ]
}
