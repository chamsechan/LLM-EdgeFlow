{
  "io": {
    "input": [
      {
        "type": "frame",
        "name": "ocr_invoice_qa"
      },
      {
        "type": "string",
        "name": "ocr_invoice_qa"
      }
    ],
    "output": [
      {
        "type": "od_out",
        "name": "ocr_invoice_qa",
        "inputs": {
          "result": "parse_invoice.document",
          "document": "read_invoice.document"
        }
      }
    ]
  },
  "models": [
    {
      "type": "ocr",
      "name": "ocr_model",
      "file": "ch_ppocr_v4_det_rec_npu.bin",
      "backend": {
        "type": "test_tensor_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    },
    {
      "type": "llm",
      "name": "llm_model",
      "file": "qwen_1.5b_npu.bin",
      "params": {
        "max_seq_len": 1024
      },
      "backend": {
        "type": "test_causal_lm_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "ocr_detect",
      "name": "read_invoice",
      "params": {
        "bind_model": "ocr_model"
      },
      "inputs": {
        "images": "input.image"
      }
    },
    {
      "type": "text_template",
      "name": "build_prompt",
      "params": {
        "template": "请根据以下OCR识别出的发票单据内容，回答用户的问题并以JSON输出：\n【单据内容】：\n{{document}}\n【用户问题】：{{primary}}\n【提取结果】："
      },
      "inputs": {
        "primary": "input.question",
        "document": "read_invoice.document"
      }
    },
    {
      "type": "llm_generate",
      "name": "generate_invoice",
      "params": {
        "bind_model": "llm_model",
        "temperature": 0.1,
        "endpoints": {
          "invoice": {}
        }
      },
      "inputs": {
        "input": "build_prompt.text"
      }
    },
    {
      "type": "structured_json_parse",
      "name": "parse_invoice",
      "inputs": {
        "text": "generate_invoice.text"
      }
    }
  ]
}
