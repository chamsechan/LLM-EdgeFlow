{
  "io": {
    "input": [
      {
        "type": "entity_in",
        "name": "entity_extract"
      }
    ],
    "output": [
      {
        "type": "entity_out",
        "name": "entity_extract",
        "inputs": {
          "entities": "parse_entities.document"
        }
      }
    ]
  },
  "models": [
    {
      "type": "llm",
      "name": "entity_llm",
      "file": "artifacts/neutral-llm.fixture",
      "backend": {
        "type": "test_causal_lm_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "text_template",
      "name": "build_prompt",
      "params": {
        "template": "你是一个中文实体与名词抽取助手。请从以下句子中提取出所有名词与实体，并仅以JSON列表形式返回：\n输入文本：{{primary}}\n提取结果："
      },
      "inputs": {
        "primary": "input.sentence_text"
      }
    },
    {
      "type": "llm_generate",
      "name": "generate_entities",
      "params": {
        "bind_model": "entity_llm",
        "max_tokens": 64,
        "temperature": 0.1,
        "endpoints": {
          "entities": {}
        }
      },
      "inputs": {
        "input": "build_prompt.text"
      }
    },
    {
      "type": "structured_json_parse",
      "name": "parse_entities",
      "params": {
        "fallback": []
      },
      "inputs": {
        "text": "generate_entities.text"
      }
    }
  ]
}
