{
  "deployment": {
    "io": {
      "io_binding": "entity_extract.operator.v1"
    }
  },
  "models": [
    {
      "model_type": "test_biz_llm",
      "backend": "test_causal_lm_backend",
      "model_config": {
        "max_batch_size": 2,
        "max_seq_len": 512
      },
      "backend_config": {},
      "model_id": "entity_llm",
      "model_path": "demo/fixtures/mock/artifacts/neutral-llm.fixture"
    }
  ],
  "pipeline": [
    {
      "id": "node_0_TextTemplateNode",
      "node_type": "TextTemplateNode",
      "config": {
        "template": "你是一个中文实体与名词抽取助手。请从以下句子中提取出所有名词与实体，并仅以JSON列表形式返回：\n输入文本：{{primary}}\n提取结果："
      },
      "inputs": {
        "primary": "input_sentences"
      },
      "outputs": {
        "text": "prompt_text"
      }
    },
    {
      "id": "node_1_LlmGenerateNode",
      "node_type": "LlmGenerateNode",
      "config": {
        "bind_model": "entity_llm",
        "max_tokens": 64,
        "temperature": 0.1
      },
      "inputs": {
        "prompt": "prompt_text"
      },
      "outputs": {
        "text": "llm_raw_answer"
      }
    },
    {
      "id": "node_2_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "config": {
        "fallback_json": "[]"
      },
      "inputs": {
        "text": "llm_raw_answer"
      },
      "outputs": {
        "document": "extracted_entities"
      }
    }
  ]
}
