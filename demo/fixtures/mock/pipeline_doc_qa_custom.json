{
  "io": {
    "input": [
      {
        "type": "doc_in",
        "name": "doc_qa"
      }
    ],
    "output": [
      {
        "type": "doc_out",
        "name": "doc_qa",
        "inputs": {
          "answer_text": "generate_answer.output",
          "intent": "match_intent.matches",
          "chunk_count": "chunk_docs.chunk_counts"
        }
      }
    ]
  },
  "models": [
    {
      "type": "llm",
      "name": "llm_model",
      "file": "artifacts/neutral-llm.fixture",
      "params": {
        "max_seq_len": 1024
      },
      "backend": {
        "type": "test_causal_lm_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "text_chunk",
      "name": "chunk_docs",
      "params": {
        "chunk_size": 60
      },
      "inputs": {
        "text": "input.doc_text"
      }
    },
    {
      "type": "text_rule_match",
      "name": "match_intent",
      "params": {
        "default_category": "GENERAL_QA",
        "default_score": 0.9,
        "categories": {
          "AFTER_SALES_REFUND": [
            "退款",
            "退货",
            "换货",
            "发票"
          ],
          "LOGISTICS_STATUS": [
            "快递",
            "发货",
            "物流",
            "送到哪里"
          ],
          "TECH_ARCHITECTURE": [
            "架构",
            "设计",
            "C++",
            "算法框架",
            "NPU"
          ]
        }
      },
      "inputs": {
        "text": "input.query_text"
      }
    },
    {
      "type": "prompt_guided_llm",
      "name": "generate_answer",
      "params": {
        "bind_model": "llm_model",
        "prompt_template": "【参考片段】: {{context}}\n【用户提问】: {{input}}\n请基于参考片段给出精确解答:",
        "strip_markdown": true,
        "temperature": 0.3
      },
      "inputs": {
        "input": "input.query_text",
        "context": "chunk_docs.chunks"
      }
    }
  ]
}
