{
  "io": {
    "input": [
      {
        "type": "entity_in",
        "name": "translate"
      }
    ],
    "output": [
      {
        "type": "entity_out",
        "name": "translate",
        "inputs": {
          "translation": "translate_text.text"
        }
      }
    ]
  },
  "models": [
    {
      "type": "llm",
      "name": "translate_llm",
      "file": "artifacts/neutral-llm.fixture",
      "backend": {
        "type": "test_causal_lm_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "llm_generate",
      "name": "translate_text",
      "params": {
        "bind_model": "translate_llm",
        "max_tokens": 64,
        "temperature": 0.0,
        "endpoints": {
          "translation": {}
        }
      },
      "inputs": {
        "input": "input.query"
      }
    }
  ]
}
