{
  "io": {
    "input": [
      {
        "type": "audio_in",
        "name": "audio_asr_intent"
      }
    ],
    "output": [
      {
        "type": "audio_out",
        "name": "audio_asr_intent",
        "inputs": {
          "transcribed_text": "transcribe_audio.text",
          "intent_slot": "match_intent.matches"
        }
      }
    ]
  },
  "models": [
    {
      "type": "asr",
      "name": "asr_model",
      "file": "paraformer_asr_npu.bin",
      "backend": {
        "type": "test_tensor_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "type": "asr_transcribe",
      "name": "transcribe_audio",
      "params": {
        "bind_model": "asr_model"
      },
      "inputs": {
        "audio": "input.audio"
      }
    },
    {
      "type": "text_rule_match",
      "name": "match_intent",
      "params": {
        "default_category": "GENERAL_VOICE_CMD",
        "categories": {
          "MUSIC_PLAY": [
            "播放",
            "音乐",
            "我想听"
          ],
          "NAVIGATION": [
            "导航",
            "路线",
            "去哪"
          ],
          "VEHICLE_HVAC_CONTROL": [
            "空调",
            "温度",
            "风量",
            "二档"
          ]
        },
        "rules": [
          {
            "id": "nav_dest_avoid",
            "strategy": "regex",
            "pattern": "导航到(?<destination>.+?)(?:，|,|。|\\s|$).*?(?<avoid_traffic>避开拥堵)",
            "category": "NAVIGATION",
            "constants": {
              "avoid_toll": false,
              "avoid_traffic": true
            }
          },
          {
            "id": "nav_dest",
            "strategy": "regex",
            "pattern": "导航到(?<destination>.+?)(?:，|,|。|\\s|$)",
            "category": "NAVIGATION",
            "constants": {
              "avoid_toll": false
            }
          },
          {
            "id": "hvac_temp_fan",
            "strategy": "regex",
            "pattern": "空调.*?(?:调到|设为)?(?<temperature>\\d+)度.*?(?<fan_speed>\\d+|一|二|三|四)档",
            "category": "VEHICLE_HVAC_CONTROL",
            "constants": {
              "temperature": 24,
              "fan_speed": 2
            }
          },
          {
            "id": "hvac_temp_fan_general",
            "strategy": "regex",
            "pattern": "(?:调到|设为)?(?<temperature>\\d+)度.*?(?<fan_speed>\\d+|一|二|三|四)档",
            "category": "VEHICLE_HVAC_CONTROL",
            "constants": {
              "temperature": 24,
              "fan_speed": 2
            }
          },
          {
            "id": "hvac_temp",
            "strategy": "regex",
            "pattern": "空调(?:调到|设为)?(?<temperature>\\d+)度",
            "category": "VEHICLE_HVAC_CONTROL",
            "constants": {
              "temperature": 24
            }
          },
          {
            "id": "hvac_fan",
            "strategy": "regex",
            "pattern": "风(?:速|量)?(?:开到)?(?<fan_speed>\\d+|一|二|三|四)档",
            "category": "VEHICLE_HVAC_CONTROL",
            "constants": {
              "fan_speed": 2
            }
          },
          {
            "id": "music_play",
            "strategy": "regex",
            "pattern": "播放歌曲(?<song_name>.+)",
            "category": "MUSIC_PLAY"
          }
        ]
      },
      "inputs": {
        "text": "transcribe_audio.text"
      }
    }
  ]
}
