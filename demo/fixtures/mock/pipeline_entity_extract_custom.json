{
  "io": {
    "input": [
      {
        "type": "entity_in",
        "name": "entity_extract"
      }
    ],
    "output": [
      {
        "type": "entity_out",
        "name": "entity_extract"
      }
    ]
  },
  "models": [
    {
      "type": "llm",
      "name": "entity_llm",
      "file": "artifacts/neutral-llm.fixture",
      "backend": {
        "type": "test_causal_lm_backend",
        "params": {
          "fixed_batch_size": 2
        }
      }
    }
  ],
  "pipeline": [
    {
      "id": "custom_prompt",
      "node_type": "PromptGuidedLlmNode",
      "config": {
        "bind_model": "entity_llm",
        "prompt_template": "你是一个中文实体与名词抽取助手。请从以下句子中提取出所有名词与实体，并仅以JSON列表形式返回：\n输入文本：{{input}}\n提取结果：",
        "strip_markdown": true,
        "temperature": 0.1,
        "max_tokens": 64
      },
      "inputs": {
        "input": "input_sentences"
      },
      "outputs": {
        "output": "llm_raw_answer"
      }
    },
    {
      "id": "node_2_StructuredJsonParseNode",
      "node_type": "StructuredJsonParseNode",
      "config": {
        "failure_policy": "fail"
      },
      "inputs": {
        "text": "llm_raw_answer"
      },
      "outputs": {
        "document": "extracted_entities"
      }
    }
  ]
}
