# Toolchain / preset 在 project() 之前确定编译器、SDK 和目标架构。
# 本入口只读取 CMake 的目标信息并校验；Backend 与依赖模块据此决定各自的默认策略。
if(CMAKE_CONFIGURATION_TYPES)
  message(FATAL_ERROR "Use a single-config generator such as Ninja; multi-config builds are not supported")
endif()
set(_edgeflow_processor "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES)
  list(LENGTH CMAKE_OSX_ARCHITECTURES _edgeflow_arch_count)
  if(NOT _edgeflow_arch_count EQUAL 1)
    message(FATAL_ERROR "Build one macOS architecture per directory; universal dependency packages are not provided")
  endif()
  set(_edgeflow_processor "${CMAKE_OSX_ARCHITECTURES}")
endif()
string(TOLOWER "${_edgeflow_processor}" _edgeflow_processor)
if(_edgeflow_processor MATCHES "^(aarch64|arm64)$")
  set(LLM_EDGEFLOW_TARGET_ARCH arm64)
elseif(_edgeflow_processor MATCHES "^(x86_64|amd64)$")
  set(LLM_EDGEFLOW_TARGET_ARCH x86_64)
else()
  message(FATAL_ERROR "Unsupported target architecture: ${_edgeflow_processor}")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(LLM_EDGEFLOW_TARGET_OS linux)
  set(LLM_EDGEFLOW_BINARY_FORMAT ELF)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  set(LLM_EDGEFLOW_TARGET_OS macos)
  set(LLM_EDGEFLOW_BINARY_FORMAT MachO)
else()
  message(FATAL_ERROR "Unsupported target system: ${CMAKE_SYSTEM_NAME}; use Linux or macOS")
endif()
set(LLM_EDGEFLOW_TARGET_PLATFORM "${LLM_EDGEFLOW_TARGET_OS}-${LLM_EDGEFLOW_TARGET_ARCH}")
set(LLM_EDGEFLOW_EXPECTED_PLATFORM "" CACHE STRING "Optional preset assertion for the resolved target platform")
if(LLM_EDGEFLOW_EXPECTED_PLATFORM AND
   NOT LLM_EDGEFLOW_EXPECTED_PLATFORM STREQUAL LLM_EDGEFLOW_TARGET_PLATFORM)
  message(FATAL_ERROR
    "Preset requires ${LLM_EDGEFLOW_EXPECTED_PLATFORM}, but the toolchain targets ${LLM_EDGEFLOW_TARGET_PLATFORM}. Use a fresh build directory and the matching toolchain.")
endif()
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The selected target requires a 64-bit ABI")
endif()

# 禁止在已有构建目录里静默切换目标，依赖查找前就给出明确诊断。
if(DEFINED LLM_EDGEFLOW_CONFIGURED_PLATFORM AND
   NOT LLM_EDGEFLOW_CONFIGURED_PLATFORM STREQUAL LLM_EDGEFLOW_TARGET_PLATFORM)
  message(FATAL_ERROR "Target platform changed; configure in a fresh build directory")
endif()
set(LLM_EDGEFLOW_CONFIGURED_PLATFORM "${LLM_EDGEFLOW_TARGET_PLATFORM}" CACHE INTERNAL "Configured target platform")

set(LLM_EDGEFLOW_NATIVE_EXECUTION ON)
if(CMAKE_CROSSCOMPILING)
  set(LLM_EDGEFLOW_NATIVE_EXECUTION OFF)
endif()
if(LLM_EDGEFLOW_TARGET_OS STREQUAL "macos")
  string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _edgeflow_host_processor)
  if(_edgeflow_host_processor MATCHES "^(aarch64|arm64)$")
    set(_edgeflow_host_processor arm64)
  elseif(_edgeflow_host_processor MATCHES "^(x86_64|amd64)$")
    set(_edgeflow_host_processor x86_64)
  endif()
  if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" OR
     NOT _edgeflow_host_processor STREQUAL LLM_EDGEFLOW_TARGET_ARCH)
    set(LLM_EDGEFLOW_NATIVE_EXECUTION OFF)
  endif()
endif()
option(BUILD_TESTING "Build native host and runtime tests" ${LLM_EDGEFLOW_NATIVE_EXECUTION})
if(BUILD_TESTING AND NOT LLM_EDGEFLOW_NATIVE_EXECUTION)
  message(FATAL_ERROR
    "Cross builds compile target artifacts only. Set BUILD_TESTING=OFF; run the native gate separately on the target (on Apple Silicon use a native arm64 terminal). Python/tooling tests execute target programs.")
endif()
message(STATUS "LLM-EdgeFlow target: ${LLM_EDGEFLOW_TARGET_PLATFORM}; cross compiling: ${CMAKE_CROSSCOMPILING}")
