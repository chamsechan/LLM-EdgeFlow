{
  "version": 1,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/variants/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "LLM_EDGEFLOW_EXPECTED_PLATFORM": "",
        "ENABLE_ONNXRUNTIME": "OFF",
        "ENABLE_LLAMACPP": "OFF",
        "ENABLE_WHISPERCPP": "OFF",
        "ENABLE_KITELLM": "OFF",
        "ENABLE_INFERLET": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_REAL_MODEL_TESTS": "OFF",
        "ENABLE_SANITIZERS": "OFF",
        "LLM_EDGEFLOW_LLAMACPP_METAL": "OFF",
        "LLM_EDGEFLOW_TEST_PCH": "OFF"
      }
    },
    {
      "name": "dev-gate",
      "displayName": "Default development gate (Inferlet)",
      "inherits": "inferlet-cpu",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "full-cpu",
      "displayName": "Explicit ONNX Runtime + llama.cpp + Whisper build",
      "inherits": "base",
      "cacheVariables": {
        "ENABLE_ONNXRUNTIME": "ON",
        "ENABLE_LLAMACPP": "ON",
        "ENABLE_WHISPERCPP": "ON"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": [
            "onnxruntime",
            "llama_cpp",
            "whisper_cpp"
          ]
        }
      }
    },
    {
      "name": "macos-arm64-cpu",
      "displayName": "macOS Apple Silicon CPU (M3 and arm64)",
      "inherits": "full-cpu",
      "cacheVariables": {
        "LLM_EDGEFLOW_EXPECTED_PLATFORM": "macos-arm64",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_SYSROOT": "macosx",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": ["onnxruntime", "llama_cpp", "whisper_cpp"]
        }
      }
    },
    {
      "name": "linux-arm64-cross",
      "displayName": "GNU/Linux arm64 SDK cross compilation",
      "inherits": "minimal",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake_ext/toolchains/linux-arm64.cmake",
        "LLM_EDGEFLOW_EXPECTED_PLATFORM": "linux-arm64",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "kite-cpu",
      "inherits": "base",
      "cacheVariables": {
        "ENABLE_KITELLM": "ON"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": [
            "kite_llm"
          ]
        }
      }
    },
    {
      "name": "inferlet-cpu",
      "inherits": "base",
      "cacheVariables": {
        "ENABLE_INFERLET": "ON"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": [
            "inferlet"
          ]
        }
      }
    },
    {
      "name": "minimal",
      "inherits": "base",
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": []
        }
      }
    }
  ]
}
