{
  "version": 1,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/variants/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "ENABLE_ONNXRUNTIME": "OFF",
        "ENABLE_LLAMACPP": "OFF",
        "ENABLE_WHISPERCPP": "OFF",
        "ENABLE_KITELLM": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_REAL_MODEL_TESTS": "OFF",
        "ENABLE_SANITIZERS": "OFF",
        "LLM_EDGEFLOW_TEST_PCH": "OFF"
      }
    },
    {
      "name": "dev-gate",
      "displayName": "Default development gate (ONNX Runtime + llama.cpp)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "ENABLE_ONNXRUNTIME": "ON",
        "ENABLE_LLAMACPP": "ON"
      }
    },
    {
      "name": "default-cpu",
      "displayName": "Full CPU capabilities (including Whisper)",
      "inherits": "dev-gate",
      "binaryDir": "${sourceDir}/build/variants/${presetName}",
      "cacheVariables": {
        "ENABLE_WHISPERCPP": "ON"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": [
            "onnxruntime",
            "llama_cpp",
            "whisper_cpp"
          ]
        }
      }
    },
    {
      "name": "kite-cpu",
      "inherits": "base",
      "cacheVariables": {
        "ENABLE_ONNXRUNTIME": "ON",
        "ENABLE_KITELLM": "ON"
      },
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": [
            "onnxruntime",
            "kite_llm"
          ]
        }
      }
    },
    {
      "name": "minimal",
      "inherits": "base",
      "vendor": {
        "llm-edgeflow/selection": {
          "backends": []
        }
      }
    }
  ]
}
