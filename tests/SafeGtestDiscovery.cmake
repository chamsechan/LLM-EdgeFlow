# 即使 main 拒绝了必需用例的跳过，CMake 的 GoogleTest 模块仍会添加基于输出的
# 跳过正则。解释其生成的 CTest 条目时移除该属性；显式返回码 77 仍是唯一的
# 可选跳过信号。
function(set_tests_properties)
  set(forwarded)
  set(drop_value OFF)
  math(EXPR last "${ARGC} - 1")
  foreach(index RANGE 0 ${last})
    set(argument "${ARGV${index}}")
    if(drop_value)
      set(drop_value OFF)
    elseif(argument STREQUAL "SKIP_REGULAR_EXPRESSION")
      set(drop_value ON)
    else()
      string(REPLACE ";" "\\;" argument "${argument}")
      list(APPEND forwarded "${argument}")
    endif()
  endforeach()
  _set_tests_properties(${forwarded})
endfunction()
