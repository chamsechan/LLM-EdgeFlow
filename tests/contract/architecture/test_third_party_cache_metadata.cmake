cmake_minimum_required(VERSION 3.19)
if(NOT PROJECT_SOURCE_DIR OR NOT TEST_ROOT)
  message(FATAL_ERROR "Supply PROJECT_SOURCE_DIR and isolated TEST_ROOT")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/cache")
include("${PROJECT_SOURCE_DIR}/cmake_ext/third_party/ThirdPartyCacheMetadata.cmake")
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_SIZEOF_VOID_P 8)
set(CMAKE_C_COMPILER_ID GNU)
set(CMAKE_C_COMPILER_VERSION 13)
set(CMAKE_CXX_COMPILER_ID GNU)
set(CMAKE_CXX_COMPILER_VERSION 13)
set(CMAKE_CXX_STANDARD 17)
function(probe kind)
  edgeflow_prepare_third_party_cache(
    NAME neutral VERSION pinned-source SOURCE_SHA256 abc123
    CACHE_DIR "${TEST_ROOT}/cache" KIND "${kind}"
    MARKER_ROOT "${TEST_ROOT}/markers" ABI_OPTIONS ${ARGN}
    OUT_VALID valid OUT_MARKER marker)
  set(valid "${valid}" PARENT_SCOPE)
  set(marker "${marker}" PARENT_SCOPE)
endfunction()
probe(STATIC z=2 a=1)
if(valid)
  message(FATAL_ERROR "Unmarked cache must not be trusted")
endif()
file(READ "${marker}" original)
if(NOT original MATCHES "version=pinned-source" OR NOT original MATCHES "abi_options=a=1,z=2")
  message(FATAL_ERROR "Marker must expose pinned source and canonical ABI options")
endif()
configure_file("${marker}" "${TEST_ROOT}/cache/.edgeflow-cache-fingerprint" COPYONLY)
probe(STATIC a=1 z=2)
if(NOT valid)
  message(FATAL_ERROR "Matching marker should be reusable regardless of option order")
endif()
set(CMAKE_CXX_COMPILER_VERSION 14)
probe(STATIC a=1 z=2)
if(valid)
  message(FATAL_ERROR "Changed compiler ABI reused stale static cache")
endif()
set(CMAKE_CXX_COMPILER_VERSION 13)
probe(STATIC a=1 z=3)
if(valid)
  message(FATAL_ERROR "Changed ABI option reused stale cache")
endif()
probe(HEADER_ONLY)
configure_file("${marker}" "${TEST_ROOT}/cache/.edgeflow-cache-fingerprint" COPYONLY)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_CXX_COMPILER_VERSION 99)
probe(HEADER_ONLY)
if(NOT valid)
  message(FATAL_ERROR "Header-only cache must not depend on platform/compiler ABI")
endif()
probe(PREBUILT)
configure_file("${marker}" "${TEST_ROOT}/cache/.edgeflow-cache-fingerprint" COPYONLY)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
probe(PREBUILT)
if(valid)
  message(FATAL_ERROR "Prebuilt cache must depend on platform ABI")
endif()
file(WRITE "${TEST_ROOT}/invalid.cmake"
  "include(\"${PROJECT_SOURCE_DIR}/cmake_ext/third_party/ThirdPartyCacheMetadata.cmake\")\nedgeflow_prepare_third_party_cache(NAME invalid KIND UNKNOWN)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${TEST_ROOT}/invalid.cmake"
                RESULT_VARIABLE invalid_result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(invalid_result EQUAL 0 OR NOT "${output}${error}" MATCHES "requires")
  message(FATAL_ERROR "Incomplete cache metadata request must fail")
endif()
include("${PROJECT_SOURCE_DIR}/tests/contract/architecture/test_llama_cache.cmake")
message(STATUS "PASS cache identity, ABI invalidation and actual llama cache consumer")
