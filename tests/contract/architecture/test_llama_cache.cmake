cmake_minimum_required(VERSION 3.19)
if(NOT PROJECT_SOURCE_DIR OR NOT TEST_ROOT)
  message(FATAL_ERROR "Supply PROJECT_SOURCE_DIR and isolated TEST_ROOT")
endif()
set(fixture "${TEST_ROOT}/llama")
file(MAKE_DIRECTORY "${fixture}/cmake_ext/engines" "${fixture}/neutral/include" "${fixture}/neutral/ggml/include")
foreach(module PlatformOptions third_party/ThirdPartyCacheMetadata engines/LlamaCpp engines/WhisperCpp)
  configure_file("${PROJECT_SOURCE_DIR}/cmake_ext/${module}.cmake"
                 "${fixture}/cmake_ext/${module}.cmake" COPYONLY)
endforeach()
# Tiny neutral archives exercise the cache importer; they are not vendor binaries.
file(WRITE "${fixture}/neutral/include/llama.h" "int neutral_llama();\n")
file(WRITE "${fixture}/neutral/ggml/include/ggml.h" "int neutral_ggml();\n")
file(WRITE "${fixture}/neutral/llama.cpp" "int neutral_ggml(); int neutral_llama(){return neutral_ggml();}\n")
file(WRITE "${fixture}/neutral/ggml.cpp" "int neutral_cpu(); int neutral_base(); int neutral_ggml(){return neutral_cpu()+neutral_base();}\n")
file(WRITE "${fixture}/neutral/cpu.cpp" "int neutral_cpu(){return 2;} int neutral_variant(){return NEUTRAL_VARIANT + NEUTRAL_AVX2;}\n")
file(WRITE "${fixture}/neutral/base.cpp" "int neutral_base(){return 3;}\n")
file(WRITE "${fixture}/neutral/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.19)
project(NeutralCache LANGUAGES CXX)
option(GGML_CUDA "Neutral upstream GPU option" OFF)
# Older upstream aliases translate only after the parent cache decision.
if(LLAMA_CUDA)
  set(GGML_CUDA ON CACHE BOOL "Neutral upstream GPU option" FORCE)
endif()
option(GGML_AVX2 "Neutral upstream CPU option" ON)
add_library(llama STATIC llama.cpp)
add_library(ggml STATIC ggml.cpp)
add_library(ggml-cpu STATIC cpu.cpp)
add_library(ggml-base STATIC base.cpp)
target_compile_definitions(ggml-cpu PRIVATE NEUTRAL_VARIANT=$<BOOL:${GGML_CUDA}> NEUTRAL_AVX2=$<BOOL:${GGML_AVX2}>)
target_link_libraries(llama PUBLIC ggml)
target_link_libraries(ggml PUBLIC ggml-cpu ggml-base)
]=])
file(MAKE_DIRECTORY "${fixture}/neutral-whisper/include")
file(WRITE "${fixture}/neutral-whisper/include/whisper.h" "int neutral_whisper();\n")
file(WRITE "${fixture}/neutral-whisper/whisper.cpp"
     "int neutral_ggml(); int neutral_whisper(){return neutral_ggml();} int whisper_variant(){return NEUTRAL_VARIANT;}\n")
file(WRITE "${fixture}/neutral-whisper/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.19)
project(NeutralWhisper LANGUAGES CXX)
add_library(whisper STATIC whisper.cpp)
target_link_libraries(whisper PUBLIC ggml)
target_compile_definitions(whisper PRIVATE NEUTRAL_VARIANT=$<BOOL:${GGML_CUDA}>)
]=])
file(WRITE "${fixture}/consumer.cpp" "#include <llama.h>\nint main(){return neutral_llama()==5?0:1;}\n")
file(WRITE "${fixture}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.19)
project(CacheConsumer LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
if(TEST_INTERNAL_GGML)
  set(GGML_DETECTED_TEST ON CACHE INTERNAL "Neutral upstream detection result")
endif()
if(TEST_NORMAL_GGML)
  set(GGML_AVX2 OFF)
endif()
set(ENABLE_LLAMACPP ON CACHE BOOL "" FORCE)
set(ENABLE_WHISPERCPP ON CACHE BOOL "" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(FETCHCONTENT_SOURCE_DIR_WHISPER_CPP_SOURCE "${CMAKE_SOURCE_DIR}/neutral-whisper" CACHE PATH "" FORCE)
set(GGML_BLAS OFF CACHE BOOL "" FORCE)
set(FETCHCONTENT_SOURCE_DIR_LLAMA_CPP_SOURCE "${CMAKE_SOURCE_DIR}/neutral" CACHE PATH "" FORCE)
include(cmake_ext/PlatformOptions.cmake)
include(cmake_ext/engines/LlamaCpp.cmake)
include(cmake_ext/engines/WhisperCpp.cmake)
file(WRITE "${CMAKE_BINARY_DIR}/whisper-cache-path.txt" "${WHISPER_3RDPARTY_DIR}")
if(NOT DEFINED GGML_CPU_ARM_ARCH OR (EXPECT_DEFAULT_ARM AND NOT GGML_CPU_ARM_ARCH STREQUAL ""))
  message(FATAL_ERROR "Default ARM architecture must leave upstream selection empty")
endif()
if(EXPECT_UNCACHEABLE AND (TARGET archive_llama_cpp_to_3rdparty OR TARGET archive_whisper_cpp_to_3rdparty))
  message(FATAL_ERROR "Uncacheable configuration must not publish shared archives")
endif()
if(EXPECT_UNCACHEABLE AND LLM_EDGEFLOW_LLAMACPP_CACHEABLE)
  message(FATAL_ERROR "Untracked GGML options must disable shared archive reads and writes")
endif()
get_target_property(whisper_imported whisper IMPORTED)
if(EXPECT_IMPORTED AND NOT whisper_imported)
  message(FATAL_ERROR "Expected verified Whisper cache import")
elseif(EXPECT_UNCACHEABLE AND whisper_imported)
  message(FATAL_ERROR "Source GGML policy must also select source Whisper")
endif()
file(WRITE "${CMAKE_BINARY_DIR}/cache-path.txt" "${LLAMA_3RDPARTY_DIR}")
if(NOT LLM_EDGEFLOW_HAS_LLAMACPP)
  message(FATAL_ERROR "Neutral source must configure the llama cache path")
endif()
get_target_property(imported llama IMPORTED)
if(EXPECT_IMPORTED AND NOT imported)
  message(FATAL_ERROR "Expected verified cache import")
elseif(EXPECT_SOURCE AND imported)
  message(FATAL_ERROR "Incomplete/incompatible cache must select source")
endif()
add_executable(consumer consumer.cpp)
target_include_directories(consumer PRIVATE ${LLM_EDGEFLOW_BACKEND_INCLUDE_DIRS})
target_link_libraries(consumer PRIVATE llama whisper)
]=])
function(run_checked)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cache consumer failed (${result}): ${ARGN}\n${output}\n${error}")
  endif()
endfunction()
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/source-build" -DEXPECT_SOURCE=ON -DEXPECT_DEFAULT_ARM=ON)
run_checked("${CMAKE_COMMAND}" --build "${fixture}/source-build" --parallel 2)
run_checked("${fixture}/source-build/consumer")
file(READ "${fixture}/source-build/cache-path.txt" cache)
foreach(archive llama ggml ggml-cpu ggml-base)
  if(NOT EXISTS "${cache}/lib/lib${archive}.a")
    message(FATAL_ERROR "Actual neutral build did not publish ${archive} cache archive")
  endif()
endforeach()
if(NOT EXISTS "${cache}/.edgeflow-cache-fingerprint")
  message(FATAL_ERROR "Archive publication did not include pinned cache metadata")
endif()
file(READ "${cache}/.edgeflow-cache-fingerprint" metadata)
if(NOT metadata MATCHES "version=70adb1b4cea5ee39f867792c78dc59320921eda7" OR
   NOT metadata MATCHES "source_sha256=94d215f1fd85ded40f4674eccdbd3caf4a9b0daa00b6d72255efec922c6d94a4" OR
   NOT metadata MATCHES "BUILD_SHARED_LIBS=OFF")
  message(FATAL_ERROR "Published llama cache must identify the current source pin and ABI")
endif()
file(READ "${fixture}/source-build/whisper-cache-path.txt" whisper_cache)
set(shared_archives "${whisper_cache}/lib/libwhisper.a")
foreach(archive llama ggml ggml-cpu ggml-base)
  list(APPEND shared_archives "${cache}/lib/lib${archive}.a")
endforeach()
set(original_hashes)
foreach(archive IN LISTS shared_archives)
  file(SHA256 "${archive}" digest)
  list(APPEND original_hashes "${digest}")
endforeach()
function(assert_original_archives)
  set(current_hashes)
  foreach(archive IN LISTS shared_archives)
    file(SHA256 "${archive}" digest)
    list(APPEND current_hashes "${digest}")
  endforeach()
  if(NOT current_hashes STREQUAL original_hashes)
    message(FATAL_ERROR "Uncacheable configuration polluted default llama/Whisper archives")
  endif()
endfunction()
# Upstream options first appear during add_subdirectory. Later configurations
# retain the same identity and source targets, without publishing shared archives.
foreach(iteration RANGE 2 3)
  run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/source-build"
              -DEXPECT_SOURCE=ON -DEXPECT_UNCACHEABLE=ON)
  file(READ "${fixture}/source-build/cache-path.txt" repeated_cache)
  file(READ "${fixture}/source-build/whisper-cache-path.txt" repeated_whisper_cache)
  if(NOT repeated_cache STREQUAL cache OR NOT repeated_whisper_cache STREQUAL whisper_cache)
    message(FATAL_ERROR "Upstream option discovery changed the default cache path")
  endif()
  run_checked("${CMAKE_COMMAND}" --build "${fixture}/source-build" --parallel 2)
  assert_original_archives()
endforeach()
foreach(setting GGML_CUDA GGML_AVX2 LLAMA_CUDA)
  set(value ON)
  if(setting STREQUAL "GGML_AVX2")
    set(value OFF)
  endif()
  run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/${setting}-build"
              -DEXPECT_SOURCE=ON -DEXPECT_UNCACHEABLE=ON "-D${setting}=${value}")
  run_checked("${CMAKE_COMMAND}" --build "${fixture}/${setting}-build" --parallel 2)
  assert_original_archives()
endforeach()
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/normal-variable-build"
            -DEXPECT_SOURCE=ON -DEXPECT_UNCACHEABLE=ON -DTEST_NORMAL_GGML=ON)
run_checked("${CMAKE_COMMAND}" --build "${fixture}/normal-variable-build" --parallel 2)
assert_original_archives()
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/import-build" -DEXPECT_IMPORTED=ON)
run_checked("${CMAKE_COMMAND}" --build "${fixture}/import-build" --parallel 2)
run_checked("${fixture}/import-build/consumer")
# A caller-selected CPU feature policy must not import the previous archives.
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/cpu-policy-build"
            -DEXPECT_SOURCE=ON -DGGML_CPU_ARM_ARCH=armv8.2-a)
file(READ "${fixture}/cpu-policy-build/cache-path.txt" cpu_policy_cache)
if(cpu_policy_cache STREQUAL cache)
  message(FATAL_ERROR "Changed GGML_CPU_ARM_ARCH must use a distinct physical cache")
endif()
foreach(archive llama ggml ggml-cpu ggml-base)
  if(NOT EXISTS "${cache}/lib/lib${archive}.a")
    message(FATAL_ERROR "CPU policy change removed the original ${archive} cache archive")
  endif()
endforeach()
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/original-policy-build" -DEXPECT_IMPORTED=ON)
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/internal-detection-build"
            -DEXPECT_IMPORTED=ON -DTEST_INTERNAL_GGML=ON)
# Metadata alone cannot turn an incomplete archive set into a usable import.
file(REMOVE "${cache}/lib/libggml-cpu.a")
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/missing-build" -DEXPECT_SOURCE=ON)
file(WRITE "${cache}/.edgeflow-cache-fingerprint" "stale metadata")
run_checked("${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/stale-build" -DEXPECT_SOURCE=ON)
message(STATUS "PASS neutral source publication, imported link execution and invalid-cache fallback")
