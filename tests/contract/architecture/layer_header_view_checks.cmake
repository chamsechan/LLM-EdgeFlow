cmake_minimum_required(VERSION 3.19)
if(NOT LAYER_COMPILE_MANIFEST)
  message(FATAL_ERROR "Supply LAYER_COMPILE_MANIFEST from the actual configured targets")
endif()
include("${LAYER_COMPILE_MANIFEST}")
file(MAKE_DIRECTORY "${layer_test_root}/header-consumers")
function(check_header name scope header accepted)
  set(flags ${layer_cxx_flags})
  foreach(directory IN LISTS ${scope}_includes)
    list(APPEND flags "-I${directory}")
  endforeach()
  foreach(definition IN LISTS ${scope}_definitions)
    list(APPEND flags "-D${definition}")
  endforeach()
  set(source "${layer_test_root}/header-consumers/${name}.cpp")
  file(WRITE "${source}" "#include \"${header}\"\n")
  execute_process(COMMAND "${layer_cxx}" -std=c++17 ${flags} -fsyntax-only "${source}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(accepted AND NOT result EQUAL 0)
    message(FATAL_ERROR "Allowed ${scope} header failed: ${header}\n${output}\n${error}")
  elseif(NOT accepted AND result EQUAL 0)
    message(FATAL_ERROR "Forbidden ${scope} header became visible: ${header}")
  endif()
endfunction()
check_header(public_operator public edgeflow/operator/interface.h ON)
check_header(public_log public edgeflow/log.h ON)
check_header(model_log model_execution edgeflow/log.h ON)
check_header(model_capability model_execution engine/model_interface.h ON)
check_header(node_authoring capability_nodes nodes/authoring.h ON)
check_header(core_pipeline orchestration core/pipeline.h ON)
check_header(adapter_contract integration adapter/io_converter.h ON)
check_header(public_core_escape public core/pipeline.h OFF)
check_header(model_adapter_escape model_execution adapter/io_converter.h OFF)
check_header(node_core_escape capability_nodes core/pipeline.h OFF)
check_header(node_platform_escape capability_nodes platform_mock/operator_types.h OFF)
if(layer_has_inferlet)
  check_header(inferlet_backend model_execution_backends inferlet.h ON)
endif()
foreach(scope model_execution capability_nodes orchestration integration composition public extension alg_sdk alg_pipeline_tool)
  check_header(inferlet_escape_${scope} ${scope} inferlet.h OFF)
  if("HAVE_INFERLET=1" IN_LIST ${scope}_definitions)
    message(FATAL_ERROR "Inferlet compile definition leaked into ${scope}")
  endif()
endforeach()
message(STATUS "PASS real target header visibility and downward dependency boundaries")
