{
  "io": {
    "input": [
      {
        "type": "rerank_in",
        "name": "cross_rerank"
      }
    ],
    "output": [
      {
        "type": "rerank_out",
        "name": "cross_rerank",
        "inputs": {
          "ranked": "rank_candidates.ranked"
        }
      }
    ]
  },
  "models": [
    {
      "type": "rerank",
      "name": "rerank_model",
      "file": "missing_rerank_fixture.onnx",
      "params": {
        "tokenizer_file": "vocab.txt",
        "do_lower_case": true,
        "output_name": "logits",
        "score_activation": "sigmoid",
        "max_tokens": 16
      },
      "backend": {
        "type": "onnxruntime",
        "params": {
          "max_batch_size": 4,
          "intra_op_num_threads": 1,
          "inter_op_num_threads": 1,
          "graph_optimization_level": "all"
        }
      }
    }
  ],
  "pipeline": [
    {
      "depends_on": [],
      "inputs": {
        "queries": "input.query_text",
        "candidates": "input.candidates"
      },
      "name": "rank_candidates",
      "type": "text_rerank",
      "params": {
        "bind_model": "rerank_model",
        "top_k": 8
      }
    }
  ]
}
